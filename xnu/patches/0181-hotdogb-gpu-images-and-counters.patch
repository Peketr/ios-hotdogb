+/*
+ * 0181: copy up to BYTES from GPU address IOVA out of the BO that holds it, stopping at the BO's end; returns
+ * what was copied. The buffers are GPU pool memory outside the kernel's physical map: the BO is mapped, and
+ * stays mapped for the next read (most IBs and draw states of a job sit in a few BOs).
+ */
+uint64_t
+SweetAcceleratorUserClient::v2HistRead(struct SweetGpuHist *st, uint64_t iova, uint64_t bytes, void *dst)
+{
+	if (st->km == NULL || iova < st->km_iova || iova >= st->km_iova + st->km_bytes) {
+		if (st->km != NULL) {
+			st->km->release();
+			st->km = NULL;
+		}
+		IOMemoryDescriptor *md = NULL;
+		uint64_t biova = 0, bbytes = 0;
+		IOLockLock(fLock);
+		for (uint32_t i = 0; i < fBOCap; i++) {
+			SweetV2BO *bo = &fBO[i];
+			if (bo->md != NULL && bo->iova != 0 && iova >= bo->iova && iova < bo->iova + bo->bytes) {
+				md = bo->md;
+				md->retain();
+				biova = bo->iova;
+				bbytes = bo->bytes;
+				break;
+			}
+		}
+		IOLockUnlock(fLock);
+		if (md == NULL) {
+			return 0;
+		}
+		st->km = md->map(kIOMapReadOnly);
+		md->release();
+		if (st->km == NULL) {
+			return 0;
+		}
+		st->km_iova = biova;
+		st->km_bytes = bbytes < st->km->getLength() ? bbytes : st->km->getLength();
+	}
+	uint64_t off = iova - st->km_iova;
+	if (off >= st->km_bytes) {
+		return 0;
+	}
+	if (bytes > st->km_bytes - off) {
+		bytes = st->km_bytes - off;
+	}
+	memcpy(dst, (const void *)(st->km->getVirtualAddress() + off), bytes);
+	return bytes;
+}
