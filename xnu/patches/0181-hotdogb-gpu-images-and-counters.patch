+	PC_RB(0, 0, "busy"), PC_RB(1, 5, "starve_sp"), PC_RB(2, 7, "starve_ccu"), PC_RB(3, 14, "color_read"),
+	PC_RB(4, 15, "color_write"), PC_RB(5, 29, "pixels_3d"), PC_RB(6, 34, "ccu_read_stall"), PC_RB(7, 35, "ccu_write_stall"),
+};
+#define A6_NPC (sizeof(a6_pcs) / sizeof(a6_pcs[0]))
+_Static_assert(A6_NPC <= A6_PERFCTR_MAX, "a6_pcs");
+
+int a6_perfctr_start(void)
+{
+	if (!a6_gx_up())
+		return -1;
+	for (uint32_t i = 0; i < A6_NPC; i++)
+		wr32(GREG(a6_pcs[i].sel), a6_pcs[i].countable);
+	return 0;
+}
+
+int a6_perfctr_read(uint64_t *v)
+{
+	if (!a6_gx_up())
+		return -1;
+	for (uint32_t i = 0; i < A6_NPC; i++) {
+		uint32_t c = a6_pcs[i].ctr;
+		uint32_t hi = rd32(GREG(c + 1)), lo = rd32(GREG(c)), hi2 = rd32(GREG(c + 1));
+		if (hi2 != hi)
+			lo = rd32(GREG(c));
+		v[i] = (uint64_t)hi2 << 32 | lo;
+	}
+	return 0;
+}
+
+static uint64_t pc_get(const uint64_t *a, const uint64_t *b, const char *name)
+{
+	for (uint32_t i = 0; i < A6_NPC; i++)
+		if (strcmp(a6_pcs[i].name, name) == 0)
+			return b[i] - a[i];
+	return 0;
+}
+
+static unsigned pc_pct(uint64_t x, uint64_t of)
+{
+	return of ? (unsigned)(x * 100 / of) : 0;
+}
