+/*
+ * 0181: GPU performance counters for "gpuperf SECS" (sweet_gpu.c): select register, RBBM_PERFCTR_* lo register,
+ * countable (Mesa a6xx_enums.xml a6xx_{cp,uche,tp,sp,rb}_perfcounter_select). CP counter 0 stays ALWAYS_COUNT
+ * (0180) and SP counter 0 is left alone. GX stays powered while the GPU is up, so the selects hold.
+ */
+struct a6_pc {
+	uint16_t sel, ctr;
+	uint8_t countable;
+	const char *name;
+};
+#define PC_CP(n, c, s)   { 0x08d0 + (n), 0x0400 + 2 * (n), c, "cp." s }
+#define PC_UCHE(n, c, s) { 0x0e1c + (n), 0x0476 + 2 * (n), c, "uche." s }
+#define PC_TP(n, c, s)   { 0xb610 + (n), 0x048e + 2 * (n), c, "tp." s }
+#define PC_SP(n, c, s)   { 0xae10 + (n), 0x04a6 + 2 * (n), c, "sp." s }
+#define PC_RB(n, c, s)   { 0x8e10 + (n), 0x04d6 + 2 * (n), c, "rb." s }
+static const struct a6_pc a6_pcs[] = {
+	PC_CP(1, 2, "busy"), PC_CP(2, 15, "sqe_idle"), PC_CP(3, 16, "starve_ib"), PC_CP(4, 17, "starve_drawstate"),
+	PC_CP(5, 18, "starve_mrb"), PC_CP(6, 19, "starve_rrb"), PC_CP(7, 20, "starve_vsd"), PC_CP(8, 22, "pipe_out_stall"),
+	PC_CP(9, 23, "sync_stall"), PC_CP(10, 24, "wfi_stall"), PC_CP(11, 25, "sys_wfi_stall"), PC_CP(12, 29, "draws"),
+	PC_CP(13, 47, "read_beats"),
+	PC_UCHE(0, 0, "busy"), PC_UCHE(1, 1, "arbiter_stall"), PC_UCHE(2, 2, "dram_lat_cycles"),
+	PC_UCHE(3, 3, "dram_lat_samples"), PC_UCHE(4, 4, "beats_tp"), PC_UCHE(5, 5, "beats_vfd"),
+	PC_UCHE(6, 6, "beats_hlsq"), PC_UCHE(7, 8, "beats_sp"), PC_UCHE(8, 9, "reads_tp"), PC_UCHE(9, 18, "evicts"),
+	PC_UCHE(10, 29, "gmem_beats"), PC_UCHE(11, 7, "beats_lrz"),
+	PC_TP(0, 0, "busy"), PC_TP(1, 1, "uche_stall"), PC_TP(2, 2, "lat_cycles"), PC_TP(3, 3, "lat_trans"),
+	PC_TP(4, 6, "l1_lines"), PC_TP(5, 7, "l1_misses"), PC_TP(6, 10, "pixels"), PC_TP(7, 8, "sp_tp"),
+	PC_TP(8, 9, "tp_sp"), PC_TP(9, 13, "quads"), PC_TP(10, 26, "pixels_bilinear"), PC_TP(11, 19, "quads_2d"),
+	PC_SP(1, 0, "busy"), PC_SP(2, 1, "alu"), PC_SP(3, 4, "tp_stall"), PC_SP(4, 5, "uche_stall"), PC_SP(5, 6, "rb_stall"),
+	PC_SP(6, 7, "non_exec"), PC_SP(7, 20, "wave_wait"), PC_SP(8, 21, "wave_fetch"), PC_SP(9, 82, "gm_lat_cycles"),
+	PC_SP(10, 83, "gm_lat_samples"), PC_SP(11, 37, "fs_tex"), PC_SP(12, 44, "fs_instr"), PC_SP(13, 51, "icache_req"),
