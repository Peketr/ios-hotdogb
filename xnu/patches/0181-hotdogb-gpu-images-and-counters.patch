+void a6_perfctr_report(const uint64_t *a, const uint64_t *b, uint64_t ms, uint64_t busy_ms)
+{
+	uint32_t bad = 0;
+	if (a6_gx_up())
+		for (uint32_t i = 0; i < A6_NPC; i++)
+			bad += (rd32(GREG(a6_pcs[i].sel)) & 0xff) != a6_pcs[i].countable;
+	a6_log("#### GPU PERF COUNTERS OVER %llu MS (GPU BUSY %llu MS)%s\n", ms, busy_ms,
+	    bad ? " - SELECTS CHANGED, NUMBERS SUSPECT" : "");
+	char line[200];
+	uint32_t len = 0;
+	for (uint32_t i = 0; i < A6_NPC; i++) {
+		len += snprintf(line + len, sizeof(line) - len, " %s=%llu", a6_pcs[i].name, b[i] - a[i]);
+		if (len > 150 || i == A6_NPC - 1) {
+			a6_log("gpuperf raw:%s\n", line);
+			len = 0;
+		}
+	}
+#define G(s) pc_get(a, b, s)
