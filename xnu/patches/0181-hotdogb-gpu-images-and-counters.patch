+/* 0181: decode the descriptor sets the job bound and list the images in them (see the comment at the top) */
+void
+SweetAcceleratorUserClient::v2HistImages(struct SweetGpuHist *st)
+{
+	static const uint32_t set_bytes = 4096;
+	uint32_t *d = (uint32_t *)IOMallocData(set_bytes);
+	if (d == NULL) {
+		return;
+	}
+	for (uint32_t s = 0; s < st->nsets; s++) {
+		uint64_t got = v2HistRead(st, st->sets[s].base, set_bytes, d);
+		uint32_t found = 0;
+		for (uint32_t slot = 0; (slot + 1) * 64 <= got; slot++) {
+			const uint32_t *t = &d[slot * 16];
+			uint32_t type = t[2] >> 29, w = t[1] & 0x7fff, h = (t[1] >> 15) & 0x7fff;
+			uint64_t base = (t[4] & ~0x1fu) | ((uint64_t)(t[5] & 0x1ffff) << 32);
+			if (type < 1 || type > 3 || w == 0 || h == 0 || w > 16384 || h > 16384 || base == 0 || (base & 0x3f)) {
+				continue;
+			}
+			uint32_t bo = 0;
+			uint64_t bobytes = 0;
+			bool imported = false, inbo = false;
+			IOLockLock(fLock);
+			for (uint32_t i = 0; i < fBOCap; i++) {
+				if (fBO[i].md != NULL && fBO[i].iova != 0 && base >= fBO[i].iova && base < fBO[i].iova + fBO[i].bytes) {
+					inbo = true;
+					bo = i + 1;
+					bobytes = fBO[i].bytes;
+					imported = fBO[i].imported;
+					break;
+				}
+			}
+			IOLockUnlock(fLock);
+			if (!inbo) {
+				continue;
+			}
+			found++;
+			uint32_t k;
+			for (k = 0; k < st->nimg; k++) {
+				if (st->img[k].base == base && st->img[k].d[0] == t[0] && st->img[k].d[1] == t[1]) {
+					st->img[k].refs++;
+					break;
+				}
+			}
+			if (k == st->nimg) {
+				if (st->nimg == HIST_IMGS) {
+					st->img_dropped++;
+					continue;
+				}
+				struct SweetGpuHist::SweetHistImg *im = &st->img[st->nimg++];
+				im->base = base;
+				for (uint32_t j = 0; j < 4; j++) {
+					im->d[j] = t[j];
+				}
+				im->refs = 1;
+				im->bo = bo;
+				im->bobytes = bobytes;
+				im->imported = imported;
+			}
+		}
+		IOLog("GPUHIST set %u (bindless %u%s) at %#llx: %llu bytes read, %u image slots\n", s, st->sets[s].set % 5,
+		    st->sets[s].set >= 5 ? " compute" : "", st->sets[s].base, got, found);
+	}
+	IOFreeData(d, set_bytes);
+	uint32_t linear = 0, tiled = 0, ubwc = 0, imp = 0;
+	uint64_t linear_bytes = 0;
+	for (uint32_t k = 0; k < st->nimg; k++) {
+		struct SweetGpuHist::SweetHistImg *im = &st->img[k];
+		uint32_t tile = im->d[0] & 3, fmt = (im->d[0] >> 22) & 0xff, swap = im->d[0] >> 30, mips = (im->d[0] >> 16) & 0xf;
+		uint32_t w = im->d[1] & 0x7fff, h = (im->d[1] >> 15) & 0x7fff, pitch = (im->d[2] >> 7) & 0x3fffff;
+		bool flag = (im->d[3] >> 28) & 1;
+		if (tile == 0) {
+			linear++;
+			linear_bytes += (uint64_t)pitch * h;
+		} else {
+			tiled++;
+		}
+		ubwc += flag;
+		imp += im->imported;
+		IOLog("GPUHIST image %u: %ux%u fmt %#x swap %u tile %u%s%s pitch %u mips %u type %u, %#llx in BO %u "
+		    "(%llu KB%s), %u refs\n", k, w, h, fmt, swap, tile, tile ? " tiled" : " linear", flag ? " UBWC" : "", pitch,
+		    mips, im->d[2] >> 29, im->base, im->bo, im->bobytes >> 10, im->imported ? ", imported" : "", im->refs);
+	}
+	IOLog("#### GPUHIST IMAGES: %u distinct (%u linear = %llu KB, %u tiled, %u UBWC, %u imported, %u not listed), "
+	    "%u descriptor sets (%u not listed), %u draw states followed (%u not: table full)\n", st->nimg, linear,
+	    linear_bytes >> 10, tiled, ubwc, imp, st->img_dropped, st->nsets, st->sets_dropped, st->dsfollowed, st->ds_full);
+}
