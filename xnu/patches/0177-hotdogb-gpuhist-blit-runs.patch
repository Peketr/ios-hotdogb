+	/*
+	 * 0177: the 2D engine's state as the stream sets it (GRAS_A2D_SRC_XMIN..DEST_BR 0x8401-0x8406,
+	 * TPL1_A2D_SRC_TEXTURE_INFO..PITCH 0xb4c0-0xb4c4, RB_A2D_DEST_BUFFER_INFO..PITCH 0x8c17-0x8c1a), and each
+	 * CP_BLIT grouped into runs: consecutive one-row blits into the same destination, one row further down each
+	 * time, are one copy that Turnip split per row (an A6xx buffer<->image copy whose buffer rows or start are
+	 * not 64-byte aligned, tu_clear_blit.cc).
+	 */
+	uint32_t gras[6], tpl[5], rb[4];
+	struct SweetBlitRun {
+		uint64_t src0, src1, dst;
+		uint32_t srcinfo, srcpitch, dstinfo, dstpitch, x, w, h, y0, y1, n;
+	} cur, runs[40];
+	uint32_t nruns, blits, rowblits, rowruns, rowruns_dropped;
 };
 static const uint32_t hist_watch[HIST_WATCH] = { 0x80a1, 0x8800, 0x80f0, 0x88e3 };
 #define HIST_DRAWS(st)  ((st)->op[0x38] + (st)->op[0x22] + (st)->op[0x28] + (st)->op[0x29] + (st)->op[0x2a])
 
+static void
+hist_blit_close(struct SweetGpuHist *st)
+{
+	struct SweetGpuHist::SweetBlitRun *r = &st->cur;
+	if (r->n >= 2) {
+		st->rowruns++;
+		st->rowblits += r->n;
+		if (st->nruns < sizeof(st->runs) / sizeof(st->runs[0])) {
+			st->runs[st->nruns++] = *r;
+		} else {
+			st->rowruns_dropped++;
+		}
+	}
+	r->n = 0;
+}
+
+static void
+hist_blit(struct SweetGpuHist *st)
+{
+	st->blits++;
+	struct SweetGpuHist::SweetBlitRun b;
+	b.src0 = b.src1 = st->tpl[2] | ((uint64_t)st->tpl[3] << 32);
+	b.dst = st->rb[1] | ((uint64_t)st->rb[2] << 32);
+	b.srcinfo = st->tpl[0];
+	b.srcpitch = st->tpl[4];
+	b.dstinfo = st->rb[0];
+	b.dstpitch = st->rb[3];
+	b.x = (st->gras[0] >> 8) & 0x1ffff;
+	uint32_t tl = st->gras[4], br = st->gras[5];
+	b.w = (br & 0x3fff) - (tl & 0x3fff) + 1;
+	b.y0 = b.y1 = (tl >> 16) & 0x3fff;
+	b.h = ((br >> 16) & 0x3fff) - b.y0 + 1;
+	b.n = 1;
+	struct SweetGpuHist::SweetBlitRun *r = &st->cur;
+	if (r->n != 0 && b.h == 1 && r->h == 1 && b.dst == r->dst && b.w == r->w && b.srcinfo == r->srcinfo &&
+	    b.y0 == r->y1 + 1) {
+		r->src1 = b.src1;
+		r->y1 = b.y0;
+		r->n++;
+		return;
+	}
+	hist_blit_close(st);
+	*r = b;
+}
