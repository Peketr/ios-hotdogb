+/*
+ * 0153: what iOS sets on the framebuffer and the backlight service, by key: the first 4 times each, then every
+ * 200th (with the count). With kernel 0152's backlight service CoreBrightness never set a brightness and the UI
+ * fell to 0.2-0.4 fps; 0152 answered every other key with kIOReturnUnsupported, unlogged.
+ */
+#define SWEET_BL_KEYS 24
+static struct {
+	char name[48];
+	uint32_t count;
+} sweet_bl_keys[SWEET_BL_KEYS];
+
+static void
+sweet_bl_log(const char *who, OSDictionary *d)
+{
+	if (d == NULL) {
+		return;
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(d);
+	OSSymbol *k;
+	while (it != NULL && (k = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		const char *name = k->getCStringNoCopy();
+		uint32_t i, count = 0;
+		for (i = 0; i < SWEET_BL_KEYS && sweet_bl_keys[i].name[0]; i++) {
+			if (!strncmp(sweet_bl_keys[i].name, name, sizeof(sweet_bl_keys[i].name) - 1)) {
+				break;
+			}
+		}
+		if (i < SWEET_BL_KEYS) {
+			if (!sweet_bl_keys[i].name[0]) {
+				strlcpy(sweet_bl_keys[i].name, name, sizeof(sweet_bl_keys[i].name));
+			}
+			count = ++sweet_bl_keys[i].count;
+		}
+		if (count > 4 && count % 200) {
+			continue;
+		}
+		OSObject *v = d->getObject(k);
+		OSNumber *n = OSDynamicCast(OSNumber, v);
+		OSBoolean *b = OSDynamicCast(OSBoolean, v);
+		char proc[32];
+		proc_selfname(proc, sizeof(proc));
+		IOLog("SWEET BL: %s %s set %s = %s %llu (#%u)\n", proc, who, name,
+		    v ? v->getMetaClass()->getClassName() : "null",
+		    n ? n->unsigned64BitValue() : (b ? (uint64_t)b->isTrue() : 0ULL), count);
+	}
+	OSSafeReleaseNULL(it);
+}
+
+/* every key is kept as a property (so reading it back works) and accepted */
+static void
+sweet_bl_store(IOService *s, OSDictionary *d)
+{
+	OSCollectionIterator *it = d ? OSCollectionIterator::withCollection(d) : NULL;
+	OSSymbol *k;
+	while (it != NULL && (k = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		OSObject *v = d->getObject(k);
+		if (v != NULL) {
+			s->setProperty(k, v);
+		}
+	}
+	OSSafeReleaseNULL(it);
+}
