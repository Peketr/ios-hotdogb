+/*
+ * hotdogb motion sensors: sensord (userland, phone/sensors) reads the LSM6DSM accelerometer/gyro and the MMC5603
+ * magnetometer from the SLPI and hands their samples to the kernel here; SweetHID.cpp's SweetHIDAccel/Gyro/Compass
+ * services pass them to iOS (locationd's CLIoHidInterface matches HID usage pairs 0xff00/3, 0xff00/9, 0xff00/0xa).
+ *
+ * kern.sweet_motion (write-only, root): an array of struct sweet_motion_sample, at most 64 per write.
+ *   kind 0 accel (g), 1 gyro (rad/s), 2 mag (uT); x, y, z 16.16 fixed in iOS device axes; t = mach_absolute_time.
+ * Everything here is off unless the boot args carry sweetsensors=1 (the services are not even published), so a run
+ * without it behaves as before whatever state sensord is in. Writes then get ENODEV.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <sys/kauth.h>
+#include <pexpert/pexpert.h>
+
+struct sweet_motion_sample {
+	uint32_t kind;
+	int32_t  x, y, z;
+	uint64_t t;
+};
+
+#define SWEET_MOTION_MAX 64
+
+extern void sweet_hid_motion(int kind, int x, int y, int z, uint64_t t);
+int sweet_motion_enabled(void);
+
+int
+sweet_motion_enabled(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		int v = 0;
+		on = (PE_parse_boot_argn("sweetsensors", &v, sizeof(v)) && v == 1) ? 1 : 0;
+	}
+	return on;
+}
+
+static int
+sysctl_sweet_motion SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	struct sweet_motion_sample s[SWEET_MOTION_MAX];
+	static uint32_t seen;
+
+	if (!req->newptr) {
+		return EPERM;
+	}
+	if (!sweet_motion_enabled()) {
+		return ENODEV;
+	}
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	size_t len = req->newlen;
+	if (len == 0 || len % sizeof(s[0]) || len > sizeof(s)) {
+		return EINVAL;
+	}
+	int err = SYSCTL_IN(req, s, len);
+	if (err) {
+		return err;
+	}
+	for (size_t i = 0; i < len / sizeof(s[0]); i++) {
+		if (s[i].kind > 2) {
+			continue;
+		}
+		if (!(seen & (1u << s[i].kind))) {
+			static const char *const names[] = { "ACCEL", "GYRO", "COMPASS" };
+			seen |= 1u << s[i].kind;
+			printf("#### FIRST %s SAMPLE FROM SENSORD (%d %d %d / 65536)\n", names[s[i].kind],
+			    s[i].x, s[i].y, s[i].z);
+		}
+		sweet_hid_motion((int)s[i].kind, s[i].x, s[i].y, s[i].z, s[i].t);
+	}
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_motion, CTLTYPE_OPAQUE | CTLFLAG_WR | CTLFLAG_LOCKED | CTLFLAG_ANYBODY,
+    NULL, 0, sysctl_sweet_motion, "S", "hotdogb motion samples from sensord");
+#endif
