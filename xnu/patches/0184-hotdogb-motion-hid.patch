+
+/*
+ * Motion sensors (0184): accelerometer, gyro and magnetometer as the HID services locationd matches
+ * (CLIoHidInterface: usage pairs 0xff00/3, 0xff00/9, 0xff00/0xa, plus an IMULocationID / MagLocationID matching
+ * property). Samples come from sensord through kern.sweet_motion (bsd/dev/sweet_motion.c). Only published with
+ * the boot-arg sweetsensors=1: without it start() fails and iOS sees no motion hardware, as before.
+ */
+extern "C" int sweet_motion_enabled(void);
+
+class SweetHIDMotion : public IOHIDEventService {
+	OSDeclareAbstractStructors(SweetHIDMotion);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void sample(IOFixed x, IOFixed y, IOFixed z, uint64_t t);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return 0xff00; }	/* kHIDPage_AppleVendor */
+	virtual int kind() = 0;
+	UInt32 fSeq;
+};
+OSDefineMetaClassAndAbstractStructors(SweetHIDMotion, IOHIDEventService);
+
+class SweetHIDAccel : public SweetHIDMotion {
+	OSDeclareDefaultStructors(SweetHIDAccel);
+protected:
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 0x03; }	/* AppleVendor Accelerometer */
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 0x10; }
+	virtual int kind() APPLE_KEXT_OVERRIDE { return 0; }
+};
+OSDefineMetaClassAndStructors(SweetHIDAccel, SweetHIDMotion);
+
+class SweetHIDGyro : public SweetHIDMotion {
+	OSDeclareDefaultStructors(SweetHIDGyro);
+protected:
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 0x09; }	/* AppleVendor Gyro */
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 0x11; }
+	virtual int kind() APPLE_KEXT_OVERRIDE { return 1; }
+};
+OSDefineMetaClassAndStructors(SweetHIDGyro, SweetHIDMotion);
+
+class SweetHIDCompass : public SweetHIDMotion {
+	OSDeclareDefaultStructors(SweetHIDCompass);
+protected:
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 0x0a; }	/* AppleVendor Compass */
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 0x12; }
+	virtual int kind() APPLE_KEXT_OVERRIDE { return 2; }
+};
+OSDefineMetaClassAndStructors(SweetHIDCompass, SweetHIDMotion);
+
+static SweetHIDMotion *gSweetMotion[3];
+
+bool
+SweetHIDMotion::start(IOService *provider)
+{
+	if (!sweet_motion_enabled()) {
+		return false;
+	}
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	/* locationd adds {IMULocationID: N} (accel, gyro) or {MagLocationID: N} to its matching; N is 0 on one IMU. */
+	setProperty("IMULocationID", 0ULL, 32);
+	setProperty("MagLocationID", 0ULL, 32);
+	gSweetMotion[kind()] = this;
+	registerService();
+	IOLog("SWEET HID: motion %s registered (0xff00/0x%x)\n", getName(), (unsigned)getPrimaryUsage());
+	return true;
+}
+
+void
+SweetHIDMotion::sample(IOFixed x, IOFixed y, IOFixed z, uint64_t t)
+{
+	IOHIDEvent *e;
+	uint32_t seq = ++fSeq;
+
+	switch (kind()) {
+	case 0: e = IOHIDEvent::accelerometerEvent(t, x, y, z, 0, 0, seq); break;
+	case 1: e = IOHIDEvent::gyroEvent(t, x, y, z, 0, 0, seq); break;
+	default: e = IOHIDEvent::compassEvent(t, x, y, z, 0, 0, seq); break;
+	}
+	if (!e) {
+		return;
+	}
+	if (seq == 1) {
+		IOLog("#### FIRST %s EVENT SENT TO IOS HID (%u CLIENTS)\n",
+		    kind() == 0 ? "ACCEL" : (kind() == 1 ? "GYRO" : "COMPASS"), _clients ? _clients->getCount() : 0);
+	}
+	dispatchEvent(e);
+	e->release();
+}
+
+/* kind: 0 accel (g), 1 gyro (rad/s), 2 mag (uT); 16.16 fixed, iOS device axes; t: mach_absolute_time */
+extern "C" void
+sweet_hid_motion(int kind, int x, int y, int z, uint64_t t)
+{
+	if (kind >= 0 && kind < 3 && gSweetMotion[kind]) {
+		gSweetMotion[kind]->sample((IOFixed)x, (IOFixed)y, (IOFixed)z, t ? t : mach_absolute_time());
+	}
+}
