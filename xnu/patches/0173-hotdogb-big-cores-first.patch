  *	The thread must be locked.  The pset must be locked,
  *	and the resulting pset is locked on return.
  */
+#ifdef ARM64_BOARD_CONFIG_SWEET
+/*
+ * 0173: big cores first. The SM8150's eight cores are one processor set here, and an idle core is taken
+ * lowest number first: cpu0-3, the Cortex-A55s. So on a quiet phone the render thread ran on a slow core
+ * while the A76s (cpu4-7) slept. Now a timeshare thread at sweetbig (boot-arg, default 37 = user
+ * initiated; 0 = old behaviour) or above takes an idle big core when there is one, and a thread below it
+ * an idle small core; with none of its kind idle the old choice stands (any idle core, then preemption).
+ * sweetbigmask = the big cores (default 0xf0).
+ */
+TUNABLE(int, sweet_big_pri, "sweetbig", 37);
+TUNABLE(uint32_t, sweet_big_mask, "sweetbigmask", 0xf0);
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
