 choose_processor(
 	processor_set_t         starting_pset,
@@ -5041,6 +5054,21 @@
 		processor = processor->processor_primary;
 	}
 
+#ifdef ARM64_BOARD_CONFIG_SWEET
+	if (sweet_big_pri != 0 && thread->sched_pri < BASEPRI_RTQUEUES) {
+		uint64_t sweet_idle = (pset->cpu_state_map[PROCESSOR_IDLE] &
+		    pset->primary_map &
+		    pset->recommended_bitmask);
+		sweet_idle &= (thread->sched_pri >= sweet_big_pri) ? (uint64_t)sweet_big_mask : ~(uint64_t)sweet_big_mask;
+		if (sweet_idle != 0) {
+			if (processor != PROCESSOR_NULL && bit_test(sweet_idle, processor->cpu_id)) {
+				return processor;       /* where it ran last: warm caches */
+			}
+			return processor_array[lsb_first(sweet_idle)];
+		}
+	}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
