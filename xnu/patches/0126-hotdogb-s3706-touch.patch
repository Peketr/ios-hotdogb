+/*
+ * hotdogb (OnePlus 7T) touch: Synaptics S3706 (RMI4) on GENI I2C, QUPv3
+ * wrapper 2 SE0 (i2c@c80000, "qupv3_se17" pins 55/56), address 0x20.
+ * Call once after the scheduler is running; all work runs on one thread.
+ *
+ * Sources: the 7T's live FDT (i2c@0xc80000/synaptics_18865@20 and its
+ * pinctrl), Linux gcc-sm8150.c (clock gates), pinctrl-sm8150.c (tiles,
+ * qup17 = function 1), i2c-qcom-geni.c / qcom-geni-se.c (GENI I2C) and
+ * drivers/input/rmi4 (PDT, F01, F12 register descriptors and objects).
+ * The IC keeps its firmware in flash; nothing is written to it except
+ * F01 device control (configured, normal operation) and the interrupt
+ * enable mask. Needs XBL-loaded GENI I2C firmware on the SE and FIFO mode.
+ *
+ * Power (FDT): vdd 2.8-3.0 V on L17A, 1.8 V by a load switch on GPIO119,
+ * reset GPIO80 (active low), attention GPIO122 (active low).
+ *
+ * Boot-args: hdtouch=0 off, hdtouchdelay=N start after N s,
+ * hdtouchlog=1 log every object.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
+
+void sweet_s3706_init(void);
+
+#if SWEET_HOTDOGB
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+#define S3_SE_PA        0x00c80000u     /* i2c@c80000, QUPv3 2 SE0 */
+#define S3_GCC_PA       0x00100000u
+#define S3_SOUTH_PA     0x03d00000u     /* TLMM SOUTH tile: pins 55, 56, 80, 119, 122 */
+#define S3_GCC_VOTE     0x52014u        /* APCS_CLOCK_BRANCH_ENA_VOTE (wrap2) */
+/*
+ * Bit 1 wrap_2_s_ahb, 2 wrap_2_m_ahb, 4 wrap2_s0 (Linux gcc-sm8150.c);
+ * 0 and 3 wrap2 core and core_2x (downstream gcc-sm8150, not upstream).
+ */
+#define S3_GCC_BITS     0x1fu
+#define S3_RCG          0x1e148u        /* gcc_qupv3_wrap2_s0_clk_src */
+#define S3_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define S3_GPIO_IO(n)   (S3_GPIO_CFG(n) + 4u)
+#define S3_PIN_SDA      55              /* 55-56 = qup17 (function 1) */
+#define S3_PIN_SCL      56
+#define S3_PIN_RESET    80
+#define S3_PIN_1V8      119
+#define S3_PIN_ATTN     122
+#define S3_ADDR         0x20u
+#define S3_MAX          10u
+
+/* GENI (include/linux/soc/qcom/geni-se.h) */
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FIFO_OFF     0x064u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_I2C_TX_LEN   0x26cu
+#define SE_I2C_RX_LEN   0x270u
+#define SE_I2C_SCL      0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_TX_WM        0x80cu
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_DONE         (1u << 0)
+#define SE_GP_IRQS      (0x3fu << 9)    /* I2C: NACK, bus protocol, arbitration lost ... */
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_ERRORS       (0x3eu | (3u << 28) | SE_GP_IRQS)
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+#define SE_PACK0        0x0007f8feu     /* 8-bit words, 4 per FIFO entry (as i2c-qcom-geni) */
+#define SE_PACK1        0x000ffefeu
+#define I2C_WRITE       1u
+#define I2C_READ        2u
+#define I2C_STOP_STRETCH (1u << 2)
+/* 19.2 MHz XO: 400 kHz = div 2, t_high 5, t_low 11, t_cycle 22 (geni_i2c_clk_map_19p2mhz) */
+#define I2C_MCLK        ((2u << 4) | 1u)
+#define I2C_SCL         ((5u << 20) | (11u << 10) | 22u)
+
+/* RMI4 */
+#define RMI_PAGE_SELECT 0xffu
+#define RMI_PDT_START   0xe9u
+#define RMI_PDT_END     0x05u
+#define RMI_PDT_SIZE    6u
+#define RMI_PAGES       4u
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	bool started, dead;
+	int log;
+	unsigned fifo_words;
+	uint8_t page;
+	/* F01 */
+	uint16_t f01_ctrl, f01_data, f01_cmd;
+	/* F12 */
+	uint16_t f12_query, f12_data;
+	unsigned irq_count, f12_irq_pos, f12_irq_n;
+	unsigned data1_off, data1_size, fingers;
+	uint32_t active;
+	int x[S3_MAX], y[S3_MAX];
+} s3;
+static int s3_sleep_chan;
+
+static uint32_t
+s3_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+s3_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+s3_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&s3_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+s3_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(s3_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* TLMM: [1:0] pull (0 none, 1 down, 3 up), [5:2] function, [8:6] drive (mA/2 - 1), [9] output. */
+static void
+s3_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = S3_GPIO_CFG(pin);
+	if (out) {
+		s3_wr(s3.gpio, S3_GPIO_IO(pin),
+		    (s3_rd(s3.gpio, S3_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	uint32_t cfg = s3_rd(s3.gpio, off) & ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	s3_wr(s3.gpio, off, cfg);
+}
+
+static bool
+s3_clocks(void)
+{
+	s3_wr(s3.gcc, S3_GCC_VOTE, s3_rd(s3.gcc, S3_GCC_VOTE) | S3_GCC_BITS);
+	uint32_t cmd = s3_rd(s3.gcc, S3_RCG), cfg = s3_rd(s3.gcc, S3_RCG + 4u);
+	uint32_t dfs = s3_rd(s3.gcc, S3_RCG + 0x14u);
+	printf("SWEET S3706: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    s3_rd(s3.gcc, S3_GCC_VOTE), cmd, cfg, dfs);
+	if (dfs & 1u) {
+		/* CLK_SEL 0 picks DFS level 0; it must be XO (19.2 MHz) undivided. */
+		cfg = s3_rd(s3.gcc, S3_RCG + 0x1cu);
+		printf("SWEET S3706: DFS level0 cfg=%#x\n", cfg);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SWEET S3706: DFS level 0 is not XO/1; stopping\n");
+			return false;
+		}
+	} else {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		s3_wr(s3.gcc, S3_RCG + 4u, cfg);
+		s3_wr(s3.gcc, S3_RCG, s3_rd(s3.gcc, S3_RCG) | 1u);
+		if (!s3_wait_clear(s3.gcc, S3_RCG, 1u)) {
+			printf("SWEET S3706: RCG update timeout\n");
+			return false;
+		}
+	}
+	/* Branch halt bits: wrap2 m_ahb, s_ahb, s0 (hardware-gated ones skipped, as Linux). */
+	const uint32_t branches[] = {0x1e004, 0x1e008, 0x1e144};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		uint32_t cbcr = s3_rd(s3.gcc, branches[i]);
+		printf("SWEET S3706: GCC branch %#x = %#x\n", branches[i], cbcr);
+		if (cbcr & 2u) {
+			continue;
+		}
+		if (!s3_wait_clear(s3.gcc, branches[i], 1u << 31)) {
+			printf("SWEET S3706: GCC branch %#x halted (%#x)\n", branches[i],
+			    s3_rd(s3.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+s3_se_init(void)
+{
+	uint32_t fw = s3_rd(s3.se, SE_FW);
+	uint32_t tx = s3_rd(s3.se, SE_HW_TX), rx = s3_rd(s3.se, SE_HW_RX);
+	printf("SWEET S3706: se fw=%#x proto=%u status=%#x fifo-off=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, s3_rd(s3.se, SE_STATUS), s3_rd(s3.se, SE_FIFO_OFF), tx, rx);
+	/* Protocol 3 = I2C; 32-bit FIFO words. */
+	if (((fw >> 8) & 0xffu) != 3u || (s3_rd(s3.se, SE_FIFO_OFF) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 4u || ((rx >> 16) & 0x3fu) < 4u) {
+		printf("SWEET S3706: need XBL-loaded I2C firmware and 32-bit FIFOs; stopping\n");
+		return false;
+	}
+	if (s3_rd(s3.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET S3706: SE already busy; stopping\n");
+		return false;
+	}
+	s3.fifo_words = (tx >> 16) & 0x3fu;
+	/* geni_se_init + FIFO mode, polled (no GSI, no IRQ routing). */
+	s3_wr(s3.se, 0xe18, 0);
+	s3_wr(s3.se, 0xe1c, 0);
+	s3_wr(s3.se, 0x644, 0);
+	s3_wr(s3.se, SE_IRQ_CLR, 0xffffffffu);
+	s3_wr(s3.se, 0x648, 0xffffffffu);
+	s3_wr(s3.se, SE_DMA, 0);
+	s3_wr(s3.se, 0x28, s3_rd(s3.se, 0x28) | 0x7fu);
+	s3_wr(s3.se, 0xe30, s3_rd(s3.se, 0xe30) | 0x0fu);
+	s3_wr(s3.se, 0x24, 0x7f);
+	s3_wr(s3.se, 0x20, 1);
+	/* qcom_geni_i2c_conf: XO level 0, 400 kHz. */
+	s3_wr(s3.se, SE_CLK_SEL, 0);
+	s3_wr(s3.se, SE_MCLK, I2C_MCLK);
+	s3_wr(s3.se, SE_I2C_SCL, I2C_SCL);
+	s3_wr(s3.se, 0x254, 0);
+	s3_wr(s3.se, 0x260, SE_PACK0);
+	s3_wr(s3.se, 0x264, SE_PACK1);
+	s3_wr(s3.se, 0x284, SE_PACK0);
+	s3_wr(s3.se, 0x288, SE_PACK1);
+	s3_wr(s3.se, SE_TX_WM, 0);
+	s3_wr(s3.se, 0x810, ((rx >> 16) & 0x3fu) - 1u);   /* RX watermark */
+	s3_wr(s3.se, 0x814, (rx >> 16) & 0x3fu);          /* RX RFR watermark */
+	s3_wr(s3.se, SE_IRQ_EN, SE_EVENTS);
+	if ((s3_rd(s3.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (s3_rd(s3.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET S3706: inherited FIFO data; stopping\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+s3_abort(void)
+{
+	s3_wr(s3.se, SE_CTRL, 2);
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (s3_rd(s3.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	for (unsigned i = 0; i < 64 && (s3_rd(s3.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)s3_rd(s3.se, SE_RX);
+	}
+	s3_wr(s3.se, SE_IRQ_CLR, 0xffffffffu);
+	if (!done || !s3_wait_clear(s3.se, SE_STATUS, 1u)) {
+		s3.dead = true;
+		printf("SWEET S3706: abort failed status=%#x irq=%#x; stopping\n",
+		    s3_rd(s3.se, SE_STATUS), s3_rd(s3.se, SE_IRQ));
+	}
+}
+
+/*
+ * One I2C message (geni_i2c_tx_one_msg / rx_one_msg in FIFO mode). TX is
+ * refilled on the watermark, RX drained as it arrives, so a message may be
+ * longer than one FIFO fill. stretch: no STOP (a read follows).
+ */
+static int
+s3_msg(bool rd, uint8_t *buf, unsigned len, bool stretch)
+{
+	unsigned sent = 0, got = 0;
+	if (s3.dead || len == 0 || len > 256) {
+		return EIO;
+	}
+	if (!s3_wait_clear(s3.se, SE_STATUS, 1u)) {
+		s3.dead = true;
+		return EBUSY;
+	}
+	s3_wr(s3.se, SE_IRQ_CLR, 0xffffffffu);
+	s3_wr(s3.se, rd ? SE_I2C_RX_LEN : SE_I2C_TX_LEN, len);
+	if (!rd) {
+		s3_wr(s3.se, SE_TX_WM, 1);
+	}
+	s3_wr(s3.se, SE_CMD, ((rd ? I2C_READ : I2C_WRITE) << 27) | (S3_ADDR << 9) |
+	    (stretch ? I2C_STOP_STRETCH : 0u));
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = s3_rd(s3.se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			if (s3.log || (irq & ~SE_GP_IRQS & SE_ERRORS)) {
+				printf("SWEET S3706: %s error irq=%#x\n", rd ? "read" : "write", irq);
+			}
+			break;
+		}
+		if (!rd && sent < len && (irq & SE_TX_WM_IRQ)) {
+			unsigned room = s3.fifo_words - (s3_rd(s3.se, SE_TX_COUNT) & 0xfffffffu);
+			while (room-- && sent < len) {
+				uint32_t word = 0;
+				for (unsigned j = 0; j < 4 && sent < len; ++j) {
+					word |= (uint32_t)buf[sent++] << (8u * j);
+				}
+				s3_wr(s3.se, SE_TX, word);
+			}
+			if (sent == len) {
+				s3_wr(s3.se, SE_TX_WM, 0);
+			}
+		}
+		if (rd) {
+			uint32_t count = s3_rd(s3.se, SE_RX_COUNT) & 0x1ffffffu;
+			while (count-- && got < len) {
+				uint32_t word = s3_rd(s3.se, SE_RX);
+				for (unsigned j = 0; j < 4 && got < len; ++j) {
+					buf[got++] = (uint8_t)(word >> (8u * j));
+				}
+			}
+		}
+		if (irq & SE_DONE) {
+			s3_wr(s3.se, SE_IRQ_CLR, irq);
+			if (rd ? got == len : sent == len) {
+				return 0;
+			}
+			if (rd) {
+				continue; /* final RX words may land after DONE */
+			}
+			break;
+		}
+		s3_wr(s3.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	if (s3.log) {
+		printf("SWEET S3706: %s len=%u sent=%u got=%u irq=%#x status=%#x\n",
+		    rd ? "read" : "write", len, sent, got, s3_rd(s3.se, SE_IRQ),
+		    s3_rd(s3.se, SE_STATUS));
+	}
+	s3_abort();
+	return EIO;
+}
+
+/* RMI4 over I2C: 0xff selects the page, then 8-bit addresses within it. */
+static int
+s3_page(uint16_t addr)
+{
+	uint8_t page = (uint8_t)(addr >> 8);
+	if (page == s3.page) {
+		return 0;
+	}
+	uint8_t buf[2] = {RMI_PAGE_SELECT, page};
+	int err = s3_msg(false, buf, 2, false);
+	if (!err) {
+		s3.page = page;
+	} else {
+		s3.page = 0xff;
+	}
+	return err;
+}
+
+static int
+s3_read(uint16_t addr, uint8_t *out, unsigned n)
+{
+	int err = s3_page(addr);
+	if (err) {
+		return err;
+	}
+	uint8_t a = (uint8_t)addr;
+	err = s3_msg(false, &a, 1, true);
+	if (!err) {
+		err = s3_msg(true, out, n, false);
+	}
+	return err;
+}
+
+static int
+s3_write(uint16_t addr, const uint8_t *data, unsigned n)
+{
+	uint8_t buf[16];
+	if (n > sizeof(buf) - 1u) {
+		return EINVAL;
+	}
+	int err = s3_page(addr);
+	if (err) {
+		return err;
+	}
+	buf[0] = (uint8_t)addr;
+	memcpy(buf + 1, data, n);
+	return s3_msg(false, buf, n + 1u, false);
+}
+
+/*
+ * Page Description Table: entries of 6 bytes from 0xe9 down on each page
+ * (query, command, control, data base, interrupt count | version, function).
+ * Interrupt bits are assigned in scan order.
+ */
+static int
+s3_scan_pdt(void)
+{
+	unsigned irq = 0;
+	bool f01 = false, f12 = false;
+	for (unsigned page = 0; page < RMI_PAGES; ++page) {
+		unsigned found = 0;
+		for (unsigned a = RMI_PDT_START; a >= RMI_PDT_END + RMI_PDT_SIZE; a -= RMI_PDT_SIZE) {
+			uint8_t e[RMI_PDT_SIZE];
+			uint16_t addr = (uint16_t)((page << 8) | a);
+			int err = s3_read(addr, e, sizeof(e));
+			if (err) {
+				return err;
+			}
+			if (e[5] == 0 || e[5] == 0xff) {
+				break;
+			}
+			found++;
+			unsigned nirq = e[4] & 7u;
+			uint16_t base = (uint16_t)(page << 8);
+			printf("SWEET S3706: PDT page %u F%02x q=%#x c=%#x ctl=%#x d=%#x irqs=%u@%u v%u\n",
+			    page, e[5], base | e[0], base | e[1], base | e[2], base | e[3],
+			    nirq, irq, (e[4] >> 5) & 3u);
+			if (e[5] == 0x01) {
+				s3.f01_cmd = base | e[1];
+				s3.f01_ctrl = base | e[2];
+				s3.f01_data = base | e[3];
+				f01 = true;
+			} else if (e[5] == 0x12) {
+				s3.f12_query = base | e[0];
+				s3.f12_data = base | e[3];
+				s3.f12_irq_pos = irq;
+				s3.f12_irq_n = nirq;
+				f12 = true;
+			}
+			irq += nirq;
+		}
+		if (!found) {
+			break;
+		}
+	}
+	s3.irq_count = irq;
+	return f01 && f12 && irq <= 32 ? 0 : ENXIO;
+}
+
+/*
+ * F12 register descriptors (rmi_read_register_desc): query 0 says they
+ * exist; then query, control and data descriptors, 3 addresses each: size
+ * of the presence register, the presence register (bitmap of present
+ * packet registers), the structure (per present register: size, subpacket
+ * map). Data1 is the finger objects, 8 bytes each; its offset in the data
+ * packet is the size of the present data registers before it.
+ */
+static int
+s3_f12_layout(void)
+{
+	uint8_t q0;
+	int err = s3_read(s3.f12_query, &q0, 1);
+	if (err) {
+		return err;
+	}
+	if (!(q0 & 1u)) {
+		printf("SWEET S3706: F12 without register descriptors\n");
+		return ENXIO;
+	}
+	uint16_t data_desc = (uint16_t)(s3.f12_query + 1u + 2u * 3u);
+	uint8_t psize, pres[8] = {0}, st[64] = {0};
+	if ((err = s3_read(data_desc, &psize, 1))) {
+		return err;
+	}
+	if (psize < 1 || psize > sizeof(pres)) {
+		return EIO;
+	}
+	if ((err = s3_read(data_desc + 1u, pres, psize))) {
+		return err;
+	}
+	unsigned poff = 1, ssize = pres[0];
+	if (pres[0] == 0) {
+		if (psize < 3) {
+			return EIO;
+		}
+		poff = 3;
+		ssize = pres[1] | (unsigned)pres[2] << 8;
+	}
+	if (ssize == 0 || ssize > sizeof(st)) {
+		printf("SWEET S3706: F12 data descriptor of %u bytes\n", ssize);
+		return EIO;
+	}
+	if ((err = s3_read(data_desc + 2u, st, ssize))) {
+		return err;
+	}
+	unsigned off = 0, at = 0;
+	for (unsigned bit = 0; bit < 8u * (psize - poff) && at < ssize; ++bit) {
+		if (!(pres[poff + bit / 8u] & (1u << (bit % 8u)))) {
+			continue;
+		}
+		unsigned size = st[at++], subs = 0;
+		if (size == 0 && at + 2 <= ssize) {
+			size = st[at] | (unsigned)st[at + 1] << 8;
+			at += 2;
+		}
+		do {
+			if (at >= ssize) {
+				return EIO;
+			}
+			for (unsigned b = 0; b < 7; ++b) {
+				subs += (st[at] >> b) & 1u;
+			}
+		} while (st[at++] & 0x80u);
+		if (bit == 1) {
+			s3.data1_off = off;
+			s3.data1_size = size;
+			s3.fingers = MIN(subs, S3_MAX);
+			printf("SWEET S3706: F12 data1 at +%u, %u bytes, %u objects\n", off, size, subs);
+			return size >= 8u * s3.fingers && s3.fingers ? 0 : EIO;
+		}
+		off += size;
+	}
+	printf("SWEET S3706: F12 has no data1\n");
+	return ENXIO;
+}
+
+static void
+s3_report(const uint8_t *obj, unsigned id)
+{
+	/* rmi_f12_process_objects: type, x lo/hi, y lo/hi, z, wx, wy. */
+	unsigned type = obj[0];
+	int x = obj[1] | obj[2] << 8, y = obj[3] | obj[4] << 8;
+	bool down = type == 1 || type == 6;     /* finger, glove */
+	if (s3.log && (down || (s3.active & (1u << id)))) {
+		printf("SWEET S3706: obj %u type %u x %d y %d z %u\n", id, type, x, y, obj[5]);
+	}
+	if (down) {
+		/* Polled packets repeat a resting finger: report changes only. */
+		if ((s3.active & (1u << id)) && s3.x[id] == x && s3.y[id] == y) {
+			return;
+		}
+		s3.active |= 1u << id;
+		s3.x[id] = x;
+		s3.y[id] = y;
+		sweet_hid_touch((int)id, 1, x, y);
+	} else if (s3.active & (1u << id)) {
+		s3.active &= ~(1u << id);
+		sweet_hid_touch((int)id, 0, s3.x[id], s3.y[id]);
+	}
+}
+
+static void
+s3_release_all(void)
+{
+	for (unsigned id = 0; id < S3_MAX; ++id) {
+		if (s3.active & (1u << id)) {
+			sweet_hid_touch((int)id, 0, s3.x[id], s3.y[id]);
+		}
+	}
+	s3.active = 0;
+}
+
+static void
+s3_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 20;
+	int err;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("hdtouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET S3706: starting in %u s\n", delay_s);
+	s3_wait(delay_s * 1000u);
+	s3.gcc = ml_io_map(S3_GCC_PA, 0x60000);
+	s3.gpio = ml_io_map(S3_SOUTH_PA, 0x81000);
+	s3.se = ml_io_map(S3_SE_PA, 0x4000);
+	if (!s3.gcc || !s3.gpio || !s3.se) {
+		printf("SWEET S3706: MMIO mapping failed\n");
+		goto out;
+	}
+	s3.page = 0xff;
+	printf("SWEET S3706: TLMM cfg/io sda=%#x/%#x attn=%#x/%#x reset=%#x/%#x 1v8=%#x/%#x\n",
+	    s3_rd(s3.gpio, S3_GPIO_CFG(S3_PIN_SDA)), s3_rd(s3.gpio, S3_GPIO_IO(S3_PIN_SDA)),
+	    s3_rd(s3.gpio, S3_GPIO_CFG(S3_PIN_ATTN)), s3_rd(s3.gpio, S3_GPIO_IO(S3_PIN_ATTN)),
+	    s3_rd(s3.gpio, S3_GPIO_CFG(S3_PIN_RESET)), s3_rd(s3.gpio, S3_GPIO_IO(S3_PIN_RESET)),
+	    s3_rd(s3.gpio, S3_GPIO_CFG(S3_PIN_1V8)), s3_rd(s3.gpio, S3_GPIO_IO(S3_PIN_1V8)));
+	/* Reset held low while the rails come up: 2.8-3.0 V vdd, then the 1.8 V switch. */
+	s3_gpio(S3_PIN_RESET, 0, 3, 3, true, false);
+	s3_gpio(S3_PIN_ATTN, 0, 0, 3, false, false);
+	err = sweet_rpmh_vreg_enable("ldoa17", 3008);
+	if (err) {
+		printf("SWEET S3706: L17A enable failed %d; stopping\n", err);
+		goto out;
+	}
+	s3_wait(2);
+	s3_gpio(S3_PIN_1V8, 0, 3, 3, true, true);
+	s3_wait(10);
+	if (!s3_clocks()) {
+		goto out;
+	}
+	s3_gpio(S3_PIN_SDA, 1, 0, 0, false, false); /* qup17, 2 mA, no pull (FDT) */
+	s3_gpio(S3_PIN_SCL, 1, 0, 0, false, false);
+	if (!s3_se_init()) {
+		goto out;
+	}
+	s3_gpio(S3_PIN_RESET, 0, 3, 3, true, true);
+	s3_wait(150);   /* firmware boot after reset */
+	err = s3_scan_pdt();
+	if (err || s3.dead) {
+		printf("SWEET S3706: PDT scan failed %d (no F01/F12)\n", err);
+		goto out;
+	}
+	uint8_t status = 0;
+	if (!s3_read(s3.f01_data, &status, 1)) {
+		printf("SWEET S3706: F01 device status %#x\n", status);
+	}
+	err = s3_f12_layout();
+	if (err) {
+		printf("SWEET S3706: F12 layout failed %d\n", err);
+		goto out;
+	}
+	/* F01 control 0: configured (bit 7), normal sleep mode, no-sleep (bit 2). */
+	uint8_t ctl0 = 0;
+	if (!s3_read(s3.f01_ctrl, &ctl0, 1)) {
+		uint8_t v = (uint8_t)((ctl0 & ~3u) | 0x84u);
+		err = s3_write(s3.f01_ctrl, &v, 1);
+		printf("SWEET S3706: F01 ctrl0 %#x -> %#x err=%d\n", ctl0, v, err);
+	}
+	/* F01 control 1: interrupt enables; make sure the F12 sources are on. */
+	unsigned ibytes = (s3.irq_count + 7u) / 8u;
+	uint8_t ien[4] = {0};
+	if (ibytes && !s3_read(s3.f01_ctrl + 1u, ien, ibytes)) {
+		for (unsigned b = 0; b < s3.f12_irq_n; ++b) {
+			unsigned bit = s3.f12_irq_pos + b;
+			ien[bit / 8u] |= (uint8_t)(1u << (bit % 8u));
+		}
+		err = s3_write(s3.f01_ctrl + 1u, ien, ibytes);
+		printf("SWEET S3706: irq enable %02x %02x %02x %02x err=%d\n",
+		    ien[0], ien[1], ien[2], ien[3], err);
+	}
+	printf("SWEET S3706: %u objects, polling every 8 ms\n", s3.fingers);
+	uint8_t pkt[8u + 8u * S3_MAX + 64u];
+	unsigned need = s3.data1_off + 8u * s3.fingers, errors = 0, ticks = 0;
+	if (need > sizeof(pkt)) {
+		printf("SWEET S3706: data packet of %u bytes too big\n", need);
+		goto out;
+	}
+	while (!s3.dead) {
+		/* Attention is active low; also read every ~100 ms in case it is not wired as assumed. */
+		bool attn = !(s3_rd(s3.gpio, S3_GPIO_IO(S3_PIN_ATTN)) & 1u);
+		if (attn || (++ticks % 12u) == 0) {
+			uint8_t ist[4] = {0};
+			if (s3_read(s3.f01_data + 1u, ist, ibytes ? ibytes : 1u) ||
+			    s3_read(s3.f12_data, pkt, need)) {
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET S3706: read error (%u)\n", errors);
+				}
+				s3.page = 0xff;
+			} else {
+				for (unsigned id = 0; id < s3.fingers; ++id) {
+					s3_report(pkt + s3.data1_off + 8u * id, id);
+				}
+			}
+		}
+		s3_wait(8);
+	}
+	s3_release_all();
+out:
+	printf("SWEET S3706: thread exits\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_s3706_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (s3.started) {
+		return;
+	}
+	s3.started = true;
+	(void)PE_parse_boot_argn("hdtouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("hdtouchlog", &s3.log, sizeof(s3.log));
+	if (!enabled) {
+		printf("SWEET S3706: disabled (hdtouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(s3_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET S3706: kernel_thread_start failed %d\n", kr);
+	}
+}
+#else /* !SWEET_HOTDOGB */
+void
+sweet_s3706_init(void)
+{
+}
+#endif /* SWEET_HOTDOGB */
+#endif /* ARM64_BOARD_CONFIG_SWEET */
