 static errno_t
 btuart_disconnect(kern_ctl_ref ref, u_int32_t unit, void *unitinfo)
 {
-#pragma unused(ref, unit, unitinfo)
+#pragma unused(ref, unitinfo)
+	lck_mtx_lock(&bt.lock);
+	if (unit == bt.chip) {
+		bt.chip = 0;
+		printf("#### BTUART CHIP SIDE GONE\n");
+	}
+	if (unit == bt.host) {
+		bt.host = 0;
+		printf("SWEET BTUART: host unit %u (pid %d) disconnected\n", unit, bt.host_pid);
+	}
+	lck_mtx_unlock(&bt.lock);
 	return 0;
 }
 
 static errno_t
 btuart_send(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, mbuf_t m, int flags)
 {
-#pragma unused(ref, unit, unitinfo, flags)
-	mbuf_freem(m);
-	return ENOTSUP;
+#pragma unused(unitinfo, flags)
+	u_int32_t to;
+	int up;
+	lck_mtx_lock(&bt.lock);
+	up = unit != bt.chip;
+	to = up ? (unit == bt.host ? bt.chip : 0) : bt.host;
+	lck_mtx_unlock(&bt.lock);
+	if (up && unit != bt.host) {
+		mbuf_freem(m);
+		return ENXIO;	/* an old host that was taken over */
+	}
+	if (to == 0) {
+		mbuf_freem(m);
+		if (up) {
+			return ENXIO;	/* btd not running */
+		}
+		return 0;	/* chip bytes with no host: dropped */
+	}
+	if (up ? !bt.first_up++ : !bt.first_down++) {
+		printf("#### FIRST BLUETOOTH H4 BYTES %s\n", up ? "FROM THE HOST" : "TO THE HOST");
+	}
+	errno_t err = ctl_enqueuembuf(ref, to, m, 0);
+	if (err) {
+		mbuf_freem(m);
+		if (up) {
+			bt.drops_up++;
+		} else {
+			bt.drops_down++;
+		}
+		/* ENOBUFS: the reader is behind; tell the writer to retry */
+		return err == ENOBUFS ? EAGAIN : err;
+	}
+	return 0;
 }
 
