diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -485,9 +485,15 @@
 #define LVL_SVS_L1	192
 #define LVL_SVS_L2	224
 #define LVL_NOM		256
+#define LVL_NOM_L1	320
 
-static const uint32_t gpu_khz[] = { 0, 257000, 345000, 427000, 499200, 585000 };
-static const uint32_t gpu_lvl[] = { 0, LVL_LOW_SVS, LVL_SVS, LVL_SVS_L1, LVL_SVS_L2, LVL_NOM };
+/*
+ * 0179: + 675 MHz at NOM_L1, the top of the phone's own gpu_opp_table_v2 (SM8150P v2, both speed bins:
+ * 675/585/499.2/427/345/257 MHz at RPMh 320/256/224/192/128/64; downstream opp-microvolt = level + 1).
+ */
+static const uint32_t gpu_khz[A6_PERF_LEVELS + 1] = { 0, 257000, 345000, 427000, 499200, 585000, 675000 };
+static const uint32_t gpu_lvl[A6_PERF_LEVELS + 1] = { 0, LVL_LOW_SVS, LVL_SVS, LVL_SVS_L1, LVL_SVS_L2, LVL_NOM,
+    LVL_NOM_L1 };
 static const uint32_t gmu_khz[] = { 0, 200000 };
 static const uint32_t gmu_lvl[] = { 0, LVL_MIN_SVS };
 
@@ -594,15 +600,15 @@
 static int gmu_hfi(struct a6_gpu *g)
 {
 	static uint32_t msg[256];
-	uint32_t gx[6], cx[2];
-	if (arc_votes(gx, gpu_lvl, 6, "gfx.lvl", "mx.lvl") || arc_votes(cx, gmu_lvl, 2, "cx.lvl", "mx.lvl")) {
+	uint32_t gx[A6_PERF_LEVELS + 1], cx[2];
+	if (arc_votes(gx, gpu_lvl, A6_PERF_LEVELS + 1, "gfx.lvl", "mx.lvl") || arc_votes(cx, gmu_lvl, 2, "cx.lvl", "mx.lvl")) {
 		a6_log("hfi: cmd-db levels not found\n");
 		return -1;
 	}
 	memset(msg, 0, sizeof(msg));
-	msg[1] = 6;
+	msg[1] = A6_PERF_LEVELS + 1;
 	msg[2] = 2;
-	for (int i = 0; i < 6; i++) {
+	for (int i = 0; i < A6_PERF_LEVELS + 1; i++) {
 		msg[3 + 3 * i] = gx[i];
 		msg[4 + 3 * i] = 0xffffffff;
 		msg[5 + 3 * i] = gpu_khz[i];
@@ -626,7 +632,7 @@
 	msg[1] = 0;
 	rc |= hfi_send(g, 14, msg, 2);
 	rc |= hfi_send(g, 10, msg, 1);
-	uint32_t lvl = g->perf_level >= 1 && g->perf_level <= 5 ? g->perf_level : 1;
+	uint32_t lvl = g->perf_level >= 1 && g->perf_level <= A6_PERF_LEVELS ? g->perf_level : 1;
 	msg[1] = 1;
 	msg[2] = lvl;			/* index into gpu_khz */
 	msg[3] = 0;
@@ -635,6 +641,8 @@
 		g->perf_cur = lvl;
 	rc |= vote;
 	a6_log("hfi: perf/bw tables, core fw start, start, perf vote %u MHz -> %d\n", gpu_khz[lvl] / 1000, rc);
+	if (!rc)
+		a6_log("#### GPU PERF TABLE UP TO %u MHZ (%u LEVELS)\n", gpu_khz[A6_PERF_LEVELS] / 1000, A6_PERF_LEVELS);
 
 	wr32(GMU_REG(GMU_H2G_SET), 1u << 30);	/* OOB GPU_SET */
 	int ack = wait_bit(GMU_REG(GMU_G2H_INFO), 1u << 31, 1, 1000);
@@ -651,7 +659,7 @@
 int a6_set_perf(struct a6_gpu *g, uint32_t lvl)
 {
 	uint32_t msg[4] = { 0, 1, lvl, 0 };
-	if (lvl < 1 || lvl > 5)
+	if (lvl < 1 || lvl > A6_PERF_LEVELS)
 		return -1;
 	int rc = hfi_send(g, 30, msg, 4);
 	if (!rc)
@@ -661,7 +669,7 @@
 
 uint32_t a6_perf_khz(uint32_t lvl)
 {
-	return lvl <= 5 ? gpu_khz[lvl] : 0;
+	return lvl <= A6_PERF_LEVELS ? gpu_khz[lvl] : 0;
 }
 
 /* ---- zap shader through TrustZone PAS ---- */
diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
--- a/bsd/dev/sweet_a6xx.h
+++ b/bsd/dev/sweet_a6xx.h
@@ -61,6 +61,8 @@
 #define A6_GPU_ID		640
 #define A6_CHIP_ID		0x06040001ull
 
+#define A6_PERF_LEVELS	6	/* 0179: GPU levels 1..6 = 257, 345, 427, 499.2, 585, 675 MHz */
+
 struct a6_gpu {
 	uint64_t pool_pa;
 	int32_t gmu_smr, gmu_cb, gpu_smr, gpu_cb;
@@ -68,7 +70,7 @@
 	uint32_t fence;			/* last fence value submitted */
 	uint32_t hfi_seq;
 	uint32_t pt_next;		/* next free table in the arena */
-	uint32_t perf_level;		/* GMU perf vote: 1 (257 MHz) .. 5 (585 MHz); 0 = 1 */
+	uint32_t perf_level;		/* GMU perf vote: 1 (257 MHz) .. A6_PERF_LEVELS (675 MHz); 0 = 1 */
 	uint32_t perf_cur;		/* 0170: the level the GMU last acked (0 = none yet) */
 };
 
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
