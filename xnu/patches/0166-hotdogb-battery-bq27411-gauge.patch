+#if SWEET_HOTDOGB
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define BQ_SE_PA        0x00a80000u     /* i2c@a80000, QUPv3 1 SE0 (qupv3_se8_i2c) */
+#define BQ_GCC_PA       0x00100000u
+#define BQ_GCC_VOTE     0x5200cu        /* APCS_CLOCK_BRANCH_ENA_VOTE */
+/* wrap1 core_2x 18, core 19, wrap_1_m_ahb 20, wrap_1_s_ahb 21, wrap1_s0 22 (gcc-sm8150) */
+#define BQ_GCC_BITS     (0x1fu << 18)
+#define BQ_RCG          0x18148u        /* gcc_qupv3_wrap1_s0_clk_src */
+#define BQ_ADDR         0x55u
+#define BQ_DESIGN_MAH   3800u           /* stock DT qcom,batt_capacity_mah */
+
+/* GENI (include/linux/soc/qcom/geni-se.h); the same init as bsd/dev/sweet_s3706.c */
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FIFO_OFF     0x064u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_I2C_TX_LEN   0x26cu
+#define SE_I2C_RX_LEN   0x270u
+#define SE_I2C_SCL      0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_TX_WM        0x80cu
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)      /* M_GP_IRQ_1 */
+#define SE_GP_IRQS      (0x3fu << 9)
+#define SE_ERRORS       (0x3eu | (3u << 28) | SE_GP_IRQS)
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | (3u << 26) | (1u << 30))
+#define SE_PACK0        0x0007f8feu     /* 8-bit words, 4 per FIFO entry, LSB first */
+#define SE_PACK1        0x000ffefeu
+#define I2C_WRITE       1u
+#define I2C_READ        2u
+#define I2C_STOP_STRETCH (1u << 2)
+/* 19.2 MHz XO: 400 kHz = div 2, t_high 5, t_low 11, t_cycle 22 (geni_i2c_clk_map_19p2mhz) */
+#define I2C_MCLK        ((2u << 4) | 1u)
+#define I2C_SCL         ((5u << 20) | (11u << 10) | 22u)
+
+/* bq27411 / bq27421 and bq27541 standard commands (2 bytes, little endian). */
+struct bq_map {
+	uint8_t temp, volt, flags, rm, fcc, ai, soc;
+};
+static const bq_map bq27411_map = {0x02, 0x04, 0x06, 0x0c, 0x0e, 0x10, 0x1c};
+static const bq_map bq27541_map = {0x06, 0x08, 0x0a, 0x10, 0x12, 0x14, 0x2c};
+#define BQ_FLAG_FC      (1u << 9)       /* full charge (both families) */
+
+static struct {
+	vm_offset_t se, gcc;
+	bool tried, up, dead;
+	uint16_t type;
+	const bq_map *map;
+} bq;
+
+static uint32_t
+bq_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+bq_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static bool
+bq_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(bq_rd(base, off) & mask)) {
+			return true;
+		}
+		IODelay(1);
+	}
+	return false;
+}
+
+static bool
+bq_clocks(void)
+{
+	uint32_t before = bq_rd(bq.gcc, BQ_GCC_VOTE);
+	if ((before & BQ_GCC_BITS) != BQ_GCC_BITS) {
+		bq_wr(bq.gcc, BQ_GCC_VOTE, before | BQ_GCC_BITS);
+	}
+	uint32_t cmd = bq_rd(bq.gcc, BQ_RCG), cfg = bq_rd(bq.gcc, BQ_RCG + 4u);
+	uint32_t dfs = bq_rd(bq.gcc, BQ_RCG + 0x14u);
+	IOLog("SWEET BATTERY: gcc vote %#x -> %#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    before, bq_rd(bq.gcc, BQ_GCC_VOTE), cmd, cfg, dfs);
+	if (dfs & 1u) {
+		/* CLK_SEL 0 picks DFS level 0; it must be XO (19.2 MHz) undivided. */
+		cfg = bq_rd(bq.gcc, BQ_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			IOLog("SWEET BATTERY: DFS level 0 cfg=%#x is not XO/1\n", cfg);
+			return false;
+		}
+	} else if ((cfg & (0x371fu | (1u << 20))) != 1u) {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		bq_wr(bq.gcc, BQ_RCG + 4u, cfg);
+		bq_wr(bq.gcc, BQ_RCG, bq_rd(bq.gcc, BQ_RCG) | 1u);
+		if (!bq_wait_clear(bq.gcc, BQ_RCG, 1u)) {
+			IOLog("SWEET BATTERY: RCG update timeout\n");
+			return false;
+		}
+	}
+	/* Branch halt bits: wrap1 m_ahb, s_ahb, s0 (hardware-gated ones skipped, as Linux). */
+	const uint32_t branches[] = {0x18004, 0x18008, 0x18144};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		uint32_t cbcr = bq_rd(bq.gcc, branches[i]);
+		if (cbcr & 2u) {
+			continue;
+		}
+		if (!bq_wait_clear(bq.gcc, branches[i], 1u << 31)) {
+			IOLog("SWEET BATTERY: GCC branch %#x halted (%#x)\n", branches[i],
+			    bq_rd(bq.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+bq_se_init(void)
+{
+	uint32_t fw = bq_rd(bq.se, SE_FW), off = bq_rd(bq.se, SE_FIFO_OFF);
+	uint32_t tx = bq_rd(bq.se, SE_HW_TX), rx = bq_rd(bq.se, SE_HW_RX);
+	uint32_t status = bq_rd(bq.se, SE_STATUS);
+	IOLog("SWEET BATTERY: se fw=%#x proto=%u status=%#x fifo-off=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, status, off, tx, rx);
+	if (((fw >> 8) & 0xffu) != 3u) {
+		IOLog("#### BATTERY GAUGE FAILED: SE8 HAS NO I2C FIRMWARE (FW %#x)\n", fw);
+		return false;
+	}
+	if (off & 1u) {
+		IOLog("#### BATTERY GAUGE FAILED: SE8 IS GSI-ONLY (FIFO MODE DISABLED)\n");
+		return false;
+	}
+	if (((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		IOLog("#### BATTERY GAUGE FAILED: SE8 FIFO tx=%#x rx=%#x\n", tx, rx);
+		return false;
+	}
+	if (status & 0x1001u) {
+		IOLog("#### BATTERY GAUGE FAILED: SE8 BUSY (STATUS %#x)\n", status);
+		return false;
+	}
+	/* geni_se_init + FIFO mode, polled (no GSI, no IRQ routing). */
+	bq_wr(bq.se, 0xe18, 0);
+	bq_wr(bq.se, 0xe1c, 0);
+	bq_wr(bq.se, 0x644, 0);
+	bq_wr(bq.se, SE_IRQ_CLR, 0xffffffffu);
+	bq_wr(bq.se, 0x648, 0xffffffffu);
+	bq_wr(bq.se, SE_DMA, 0);
+	bq_wr(bq.se, 0x28, bq_rd(bq.se, 0x28) | 0x7fu);
+	bq_wr(bq.se, 0xe30, bq_rd(bq.se, 0xe30) | 0x0fu);
+	bq_wr(bq.se, 0x24, 0x7f);
+	bq_wr(bq.se, 0x20, 1);
+	/* qcom_geni_i2c_conf: XO level 0, 400 kHz. */
+	bq_wr(bq.se, SE_CLK_SEL, 0);
+	bq_wr(bq.se, SE_MCLK, I2C_MCLK);
+	bq_wr(bq.se, SE_I2C_SCL, I2C_SCL);
+	bq_wr(bq.se, 0x254, 0);
+	bq_wr(bq.se, 0x260, SE_PACK0);
+	bq_wr(bq.se, 0x264, SE_PACK1);
+	bq_wr(bq.se, 0x284, SE_PACK0);
+	bq_wr(bq.se, 0x288, SE_PACK1);
+	bq_wr(bq.se, SE_TX_WM, 0);
+	bq_wr(bq.se, 0x810, ((rx >> 16) & 0x3fu) - 1u);   /* RX watermark */
+	bq_wr(bq.se, 0x814, (rx >> 16) & 0x3fu);          /* RX RFR watermark */
+	bq_wr(bq.se, SE_IRQ_EN, SE_EVENTS);
+	for (unsigned i = 0; i < 64 && (bq_rd(bq.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)bq_rd(bq.se, SE_RX);
+	}
+	if (bq_rd(bq.se, SE_TX_COUNT) & 0xfffffffu) {
+		IOLog("#### BATTERY GAUGE FAILED: SE8 TX FIFO NOT EMPTY\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+bq_abort(void)
+{
+	bq_wr(bq.se, SE_CTRL, 2);       /* M_GENI_CMD_ABORT */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (bq_rd(bq.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		IODelay(1);
+	}
+	for (unsigned i = 0; i < 64 && (bq_rd(bq.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)bq_rd(bq.se, SE_RX);
+	}
+	bq_wr(bq.se, SE_IRQ_CLR, 0xffffffffu);
+	if (!done || !bq_wait_clear(bq.se, SE_STATUS, 1u)) {
+		bq.dead = true;
+		IOLog("#### BATTERY GAUGE FAILED: I2C ABORT STUCK (STATUS %#x IRQ %#x)\n",
+		    bq_rd(bq.se, SE_STATUS), bq_rd(bq.se, SE_IRQ));
+	}
+}
+
+/* One I2C message of at most 8 bytes (fits the FIFO). 0, -1 = NACK, -2 = error, -3 = timeout. */
+static int
+bq_msg(bool rd, uint8_t *buf, unsigned len, bool stretch)
+{
+	if (bq.dead || len == 0 || len > 8) {
+		return -2;
+	}
+	if (!bq_wait_clear(bq.se, SE_STATUS, 1u)) {
+		bq.dead = true;
+		IOLog("#### BATTERY GAUGE FAILED: SE8 STAYS BUSY\n");
+		return -2;
+	}
+	bq_wr(bq.se, SE_IRQ_CLR, 0xffffffffu);
+	bq_wr(bq.se, rd ? SE_I2C_RX_LEN : SE_I2C_TX_LEN, len);
+	bq_wr(bq.se, SE_CMD, ((rd ? I2C_READ : I2C_WRITE) << 27) | (BQ_ADDR << 9) |
+	    (stretch ? I2C_STOP_STRETCH : 0u));
+	if (!rd) {
+		for (unsigned i = 0; i < len; i += 4) {
+			uint32_t w = 0;
+			for (unsigned k = 0; k < 4 && i + k < len; ++k) {
+				w |= (uint32_t)buf[i + k] << (8 * k);
+			}
+			bq_wr(bq.se, SE_TX, w);
+		}
+	}
+	unsigned got = 0;
+	uint32_t irq = 0;
+	for (unsigned i = 0; i < 10000; ++i) {
+		if (rd) {
+			uint32_t words = bq_rd(bq.se, SE_RX_COUNT) & 0x1ffffffu;
+			while (words-- && got < len) {
+				uint32_t w = bq_rd(bq.se, SE_RX);
+				for (unsigned k = 0; k < 4 && got < len; ++k) {
+					buf[got++] = (uint8_t)(w >> (8 * k));
+				}
+			}
+		}
+		irq = bq_rd(bq.se, SE_IRQ);
+		if ((irq & SE_ERRORS) || ((irq & SE_DONE) && (!rd || got == len))) {
+			break;
+		}
+		IODelay(1);
+	}
+	bq_wr(bq.se, SE_IRQ_CLR, irq);
+	if (!(irq & (SE_DONE | SE_ERRORS))) {
+		bq_abort();
+		return -3;
+	}
+	if (irq & SE_NACK) {
+		return -1;
+	}
+	if ((irq & SE_ERRORS) || got != (rd ? len : 0u)) {
+		return -2;
+	}
+	return 0;
+}
+
+/* Standard command: write the command code (no STOP), read 2 bytes. */
+static int
+bq_cmd(uint8_t code, uint16_t *value)
+{
+	int rc = -2;
+	for (unsigned attempt = 0; attempt < 2 && !bq.dead; ++attempt) {
+		uint8_t b[2] = {0, 0};
+		rc = bq_msg(false, &code, 1, true);
+		if (!rc) {
+			rc = bq_msg(true, b, 2, false);
+		}
+		IODelay(100);   /* bq27xxx: >= 66 us bus free between transactions */
+		if (!rc) {
+			*value = (uint16_t)(b[0] | (b[1] << 8));
+			return 0;
+		}
+	}
+	return rc;
+}
+
+static bool
+bq_start(void)
+{
+	bq.tried = true;
+	IOLog("#### STARTING BATTERY GAUGE\n");
+	bq.gcc = ml_io_map(BQ_GCC_PA, 0x60000);
+	bq.se = ml_io_map(BQ_SE_PA, 0x1000);    /* never SE + 0x2000.. (TrustZone) */
+	if (!bq.gcc || !bq.se) {
+		IOLog("#### BATTERY GAUGE FAILED: MMIO MAPPING\n");
+		return false;
+	}
+	if (!bq_clocks()) {
+		IOLog("#### BATTERY GAUGE FAILED: SE8 CLOCKS\n");
+		return false;
+	}
+	if (!bq_se_init()) {
+		return false;
+	}
+	/* Control(DEVICE_TYPE): a read-only query, as the stock driver does at probe. */
+	uint8_t ctl[3] = {0x00, 0x01, 0x00};
+	uint16_t type = 0;
+	int rc = bq_msg(false, ctl, 3, false);
+	IODelay(100);
+	if (!rc) {
+		rc = bq_cmd(0x00, &type);
+	}
+	if (rc) {
+		IOLog("#### BATTERY GAUGE FAILED: NO ANSWER AT 0x55 (%s)\n",
+		    rc == -1 ? "NACK" : rc == -3 ? "TIMEOUT" : "BUS ERROR");
+		return false;
+	}
+	bq.type = type;
+	bq.map = type == 0x0541 ? &bq27541_map : &bq27411_map;
+	bq.up = true;
+	IOLog("#### BATTERY GAUGE UP: %s (DEVICE TYPE %#x)\n",
+	    bq.map == &bq27541_map ? "BQ27541" : "BQ27411", type);
+	return true;
+}
