+/*
+ * 0172 CPU top (bsd/dev/sweet_sample.c): the CPU time of every thread in the system so far (user and
+ * system, mach units), with its process, name, priority and - for a blocked kernel thread - the
+ * unslid continuation it will resume in. Idle threads are left out. Returns the number of threads
+ * seen; at most max are stored.
+ */
+struct sweet_top_ent {
+	uint64_t tid, user, sys, cont;
+	int pid, pri;
+	char name[24];
+};
+unsigned sweet_top_snapshot(struct sweet_top_ent *v, unsigned max);
+extern boolean_t bsd_hasthreadname(void *uth);
+extern void bsd_getthreadname(void *uth, char *buffer);
+
+unsigned
+sweet_top_snapshot(struct sweet_top_ent *v, unsigned max)
+{
+	unsigned n = 0;
+	thread_t thread;
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&threads, thread, thread_t, threads) {
+		if (thread->state & TH_IDLE) {
+			continue;
+		}
+		if (n < max) {
+			struct sweet_top_ent *e = &v[n];
+			struct recount_usage usage = { 0 };
+			task_t task = get_threadtask(thread);
+			char name[64] = "";     /* bsd_getthreadname copies MAXTHREADNAMESIZE */
+			recount_thread_usage(thread, &usage);
+			e->tid = thread->thread_id;
+			e->user = usage.ru_user_time_mach;
+			e->sys = usage.ru_system_time_mach;
+			e->pid = (task == TASK_NULL || task == kernel_task) ? 0 : pid_from_task(task);
+			e->pri = thread->sched_pri;
+			e->cont = (e->pid == 0 && thread->continuation != NULL) ?
+			    VM_KERNEL_UNSLIDE((vm_offset_t)thread->continuation) : 0;
+			void *uth = get_bsdthread_info(thread);
+			if (uth != NULL && bsd_hasthreadname(uth)) {
+				bsd_getthreadname(uth, name);
+			}
+			strlcpy(e->name, name, sizeof(e->name));
+		}
+		n++;
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	return n;
+}
+
