+/*
+ * ---- 0170: GPU frequency governor ----
+ * 0107 voted one level (sweetgpufreq, default 4 = 499 MHz) at power-up and kept it. Now a thread looks every
+ * 100 ms at the GPU time of the submits that landed in the interval (their CP_ALWAYS_ON stamps) and votes the
+ * lowest level 1..sweetgpufreq that would have kept the GPU at most 40% busy (load is measured at the current
+ * frequency: wanted = current * load / 40); 50% or more goes straight to the top. Up at once, down only after
+ * five intervals in a row asked for less and nothing is queued. The first vote the GMU does not ack stops the
+ * governor (the level stays). Boot-arg sweetgpugov=0: fixed level as before.
+ */
+#define GGOV_TICK_MS    100u
+#define GGOV_TARGET     40u
+#define GGOV_JUMP       50u
+#define GGOV_DOWN_TICKS 5u
+#define GGOV_REPORT_S   30u
+
+static void
+gpu_gov_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static int chan;
+	extern int hz;
+	uint32_t top = gpu.perf_level >= 1 && gpu.perf_level <= 5 ? gpu.perf_level : 1;
+	uint64_t last = mach_absolute_time(), report = last, busy0 = 0, khz_sum = 0;
+	unsigned down = 0, changes = 0, nticks = 0, peak = 0;
+	int ticks = (int)(GGOV_TICK_MS * (unsigned)hz / 1000u);
+	a6_log("#### GPU GOVERNOR RUNNING (every %u ms, %u-%u MHz, aims at %u%% load)\n", GGOV_TICK_MS,
+	    a6_perf_khz(1) / 1000, a6_perf_khz(top) / 1000, GGOV_TARGET);
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "gpugov", ticks > 0 ? ticks : 1);
+		lck_mtx_lock(&sweet_gpu_lock);
+		uint32_t cur = gpu.perf_cur;
+		if (!gpu_ready || cur < 1 || cur > 5) {
+			lck_mtx_unlock(&sweet_gpu_lock);
+			continue;
+		}
+		gpu_stats_locked();
+		uint64_t now = mach_absolute_time(), dt, ns;
+		absolutetime_to_nanoseconds(now - last, &dt);
+		last = now;
+		uint64_t busy_ns = (ggov_busy - busy0) * 10000 / 192;
+		busy0 = ggov_busy;
+		unsigned load = dt == 0 || busy_ns >= dt ? 100 : (unsigned)(busy_ns * 100 / dt);
+		bool queued = (int32_t)(gpu.fence - a6_fence_read(&gpu)) > 0;
+		uint32_t want = top;
+		if (load < GGOV_JUMP) {
+			uint64_t khz = (uint64_t)a6_perf_khz(cur) * load / GGOV_TARGET;
+			for (want = 1; want < top && a6_perf_khz(want) < khz; want++) {
+			}
+		}
+		if (cur > top) {
+			want = top;
+			down = GGOV_DOWN_TICKS;
+		}
+		if (want < cur && (queued || ++down < GGOV_DOWN_TICKS)) {
+			want = cur;
+		} else if (want >= cur) {
+			down = 0;
+		}
+		nticks++;
+		khz_sum += a6_perf_khz(cur);
+		if (load > peak) {
+			peak = load;
+		}
+		int rc = 0;
+		if (want != cur) {
+			rc = a6_set_perf(&gpu, want);
+			down = 0;
+			changes++;
+		}
+		lck_mtx_unlock(&sweet_gpu_lock);
+		if (rc) {
+			a6_log("#### GPU GOVERNOR STOPPED: vote for %u MHz not acked (%d), staying at %u MHz\n",
+			    a6_perf_khz(want) / 1000, rc, a6_perf_khz(cur) / 1000);
+			break;
+		}
+		absolutetime_to_nanoseconds(now - report, &ns);
+		if (ns >= GGOV_REPORT_S * 1000000000ULL) {
+			a6_log("gov %us: avg %llu MHz, now %u MHz, %u changes, busiest 100 ms %u%%\n", GGOV_REPORT_S,
+			    khz_sum / nticks / 1000, a6_perf_khz(gpu.perf_cur) / 1000, changes, peak);
+			report = now;
+			khz_sum = 0;
+			nticks = changes = peak = 0;
+		}
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gpu_gov_start(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetgpugov", &on, sizeof(on));
+	if (!on) {
+		a6_log("no governor (sweetgpugov=0): fixed at %u MHz\n", a6_perf_khz(gpu.perf_cur) / 1000);
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(gpu_gov_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
