+static void
+osm_gov_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static int chan;
+	uint64_t idle[GOV_CPUS] = { 0 }, last = mach_absolute_time(), report = last;
+	int ticks = (int)(GOV_TICK_MS * (unsigned)hz / 1000u);
+	unsigned nticks = 0;
+	for (int cpu = 0; cpu < GOV_CPUS; ++cpu) {
+		(void)sweet_processor_idle_time(cpu, &idle[cpu]);
+	}
+	printf("#### CPU GOVERNOR RUNNING (every %u ms, aims at %u%% load, top at %u%%)\n", GOV_TICK_MS,
+	    GOV_TARGET, GOV_JUMP);
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "cpugov", ticks > 0 ? ticks : 1);
+		uint64_t now = mach_absolute_time(), dt = now - last, ns;
+		if (dt == 0) {
+			continue;
+		}
+		last = now;
+		nticks++;
+		for (unsigned i = 0; i < OSM_NCLUSTERS; ++i) {
+			struct osm_cluster *c = &osm_clusters[i];
+			uint32_t load = 0;
+			for (int cpu = c->cpu0; cpu < c->cpu0 + c->ncpu; ++cpu) {
+				uint64_t t = 0;
+				if (!sweet_processor_idle_time(cpu, &t)) {
+					continue;
+				}
+				uint64_t d = t - idle[cpu];
+				idle[cpu] = t;
+				uint32_t l = d >= dt ? 0 : (uint32_t)(100 - d * 100 / dt);
+				if (l > load) {
+					load = l;
+				}
+			}
+			c->load = load;
+			if (c->n < 2) {
+				continue;
+			}
+			c->khz_ticks += c->khz[c->cur];
+			unsigned want = c->n - 1;
+			if (load < GOV_JUMP) {
+				uint64_t khz = (uint64_t)c->khz[c->cur] * load / GOV_TARGET;
+				for (want = 0; want < c->n - 1 && c->khz[want] < khz; ++want) {
+				}
+			}
+			if (want > c->cur) {
+				osm_set(c, want);
+				c->down = 0;
+			} else if (want < c->cur) {
+				if (++c->down >= GOV_DOWN_TICKS) {
+					osm_set(c, want);
+					c->down = 0;
+				}
+			} else {
+				c->down = 0;
+			}
+		}
+		absolutetime_to_nanoseconds(now - report, &ns);
+		if (ns >= GOV_REPORT_S * 1000000000ULL) {
+			char line[240];
+			unsigned len = 0;
+			for (unsigned i = 0; i < OSM_NCLUSTERS && len < sizeof(line) - 1; ++i) {
+				struct osm_cluster *c = &osm_clusters[i];
+				if (c->n < 2) {
+					continue;
+				}
+				len += snprintf(line + len, sizeof(line) - len, " %s avg %llu now %u MHz load %u%% (%u changes)",
+				    c->tag, c->khz_ticks / nticks / 1000, c->khz[c->cur] / 1000, c->load, c->switches);
+				c->khz_ticks = 0;
+				c->switches = 0;
+			}
+			printf("SWEET CPUFREQ: %us:%s\n", GOV_REPORT_S, line);
+			report = now;
+			nticks = 0;
+		}
+	}
+}
