+bool
+sweet_processor_idle_time(int cpu, uint64_t *idle_mach)
+{
+	if (cpu < 0 || cpu >= MAX_SCHED_CPUS || processor_array[cpu] == PROCESSOR_NULL) {
+		return false;
+	}
+	struct recount_usage usage = { 0 };
+	recount_processor_usage(&processor_array[cpu]->pr_recount, &usage, idle_mach);
+	return true;
+}
