+/*
+ * Charging on/off from the gauge's battery temperature, with hysteresis:
+ * on at 3.0-43.0 C, off above 45.0 C, below 0 C or without a valid gauge
+ * temperature, unchanged in between. The charge current (FCC 0x1061, 500 mA as
+ * left by the bootloader) and float voltage (0x1070) are not touched.
+ */
+void
+SweetBattery::chargePolicy(unsigned soc)
+{
+	if (!fChgAllowed || fChgDead || !fSpmi) {
+		return;
+	}
+	uint8_t cmd = 0;
+	if (sweet_spmi_read(2, 0x1042, &cmd)) {
+		return;
+	}
+	const bool on = (cmd & 1u) != 0;
+	const int t = fTempCenti;
+	bool want = on;
+	const char *why = NULL;
+	if (!fTempValid) {
+		want = false;
+		why = "NO GAUGE TEMPERATURE";
+	} else if (t > 4500) {
+		want = false;
+		why = "BATTERY TOO HOT";
+	} else if (t < 0) {
+		want = false;
+		why = "BATTERY TOO COLD";
+	} else if (t >= 300 && t <= 4300) {
+		want = true;
+	}
+	int whole = t / 100, tenth = (t < 0 ? -t : t) % 100 / 10;
+	if (want == on) {
+		if (!fChgReported) {
+			fChgReported = true;
+			IOLog("#### CHARGING %s: %s (%d.%d C, %u%%)\n", on ? "ALREADY ON" : "HELD OFF",
+			    why ? why : on ? "IN RANGE" : "43-45 C BAND", whole, tenth, soc);
+		}
+		return;
+	}
+	fChgReported = true;
+	int rc = sweet_spmi_charge_enable(want ? 1 : 0);
+	if (rc == 0) {
+		fChgFailures = 0;
+		if (want) {
+			IOLog("#### CHARGING ENABLED (BATTERY %d.%d C, %u%%)\n", whole, tenth, soc);
+		} else {
+			IOLog("#### CHARGING DISABLED: %s (%d.%d C, %u%%)\n", why ? why : "POLICY", whole, tenth, soc);
+		}
+	} else if (rc == -2 || ++fChgFailures >= 3) {
+		fChgDead = true;
+		IOLog("#### CHARGING CONTROL UNAVAILABLE (%s)\n",
+		    rc == -2 ? "CHARGER NOT OWNED BY APPS" : "WRITES FAIL");
+	}
+}
