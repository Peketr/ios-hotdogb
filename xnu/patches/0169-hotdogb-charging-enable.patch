+ * (SID 2, 0x1042) bit 0, through the apps-owned channel only, read back.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -20,6 +22,7 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 #define SP_CORE_PA 0x0c440000u
 #define SP_OBS_PA  0x0e600000u
 #define SP_CFG_PA  0x0c40a000u
+#define SP_CHNLS_PA 0x0c600000u /* owner channels, 0x10000 per APID (PMIC arb v5) */
 #define SP_NO_APID 0xffffu
 
 static vm_offset_t sp_core, sp_obs, sp_cfg;
@@ -134,4 +137,72 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+/*
+ * hotdogb: turn PM8150B charging on or off (CHARGING_ENABLE_CMD, SID 2
+ * 0x1042, bit 0; CHGR_CFG2 0x1051 selects the command as the enable source).
+ * The only PMIC write in this file. Linux spmi-pmic-arb v5: writes go through
+ * the owner channel (chnls + 0x10000 * APID) and only when the APID's owner
+ * EE is ours (apps = 0): WDATA0 (+0x10), then CMD (+0x00) EXT_WRITEL (opcode
+ * 0) BC=0, then STATUS (+0x08) done bit 0, errors bits 1-3. Read back.
+ * Returns 0, -1 (bad state/denied/timeout), -2 (not owned by apps).
+ */
+int sweet_spmi_charge_enable(int on);
+
+int
+sweet_spmi_charge_enable(int on)
+{
+	const unsigned ppid = (2u << 8) | 0x10u, addr = 0x42u;
+	if (!sp_ready) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = SP_NO_APID;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (map && ((map >> 8) & 0xfffu) == ppid && (sp_rd(sp_cfg, 0x700u + 4u * i) & 7u) == 0) {
+			apid = (uint16_t)i;
+			break;
+		}
+	}
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		printf("SWEET BATTERY: PM8150B CHGR (SID 2 0x10) not owned by apps; no charge enable\n");
+		return -2;
+	}
+	static vm_offset_t ch;
+	static uint16_t ch_apid = SP_NO_APID;
+	if (!ch || ch_apid != apid) {
+		ch = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+		ch_apid = apid;
+	}
+	if (!ch) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = on ? 1u : 0u;       /* WDATA0 */
+	*(volatile uint32_t *)(ch + 0x00u) = (0u << 27) | (addr << 4); /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	int rc = -1;
+	uint32_t status = 0;
+	for (unsigned i = 0; i < 1000; ++i) {
+		status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			rc = (status & 0x0eu) ? -1 : 0;
+			break;
+		}
+		delay(1);
+	}
+	if (!(status & 1u)) {
+		sp_poisoned[apid] = true;
+	}
+	IOLockUnlock(sp_lock);
+	uint8_t back = 0xff;
+	if (rc == 0 && (sweet_spmi_read(2, 0x1042, &back) || (back & 1u) != (on ? 1u : 0u))) {
+		rc = -1;
+	}
+	printf("SWEET BATTERY: charge enable %d -> APID %u status %#x readback %#x rc %d\n",
+	    on, apid, status, back, rc);
+	return rc;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
