+/* NCM class requests on interface 0. false: stall. */
+static bool
+ud_ncm_request(uint8_t req, uint16_t length, uint8_t *data, uint32_t *n)
+{
+	switch (req) {
+	case 0x80:                      /* GET_NTB_PARAMETERS */
+		ud_put16(data + 0, 28);
+		ud_put16(data + 2, 1);          /* NTB16 only */
+		ud_put32(data + 4, UD_NTB_MAX); /* dwNtbInMaxSize */
+		ud_put16(data + 8, 4);          /* wNdpInDivisor */
+		ud_put16(data + 10, 0);         /* wNdpInPayloadRemainder */
+		ud_put16(data + 12, 4);         /* wNdpInAlignment */
+		ud_put16(data + 14, 0);
+		ud_put32(data + 16, UD_NTB_MAX); /* dwNtbOutMaxSize */
+		ud_put16(data + 20, 4);         /* wNdpOutDivisor */
+		ud_put16(data + 22, 0);         /* wNdpOutPayloadRemainder */
+		ud_put16(data + 24, 4);         /* wNdpOutAlignment */
+		ud_put16(data + 26, 0);         /* wNtbOutMaxDatagrams: no limit */
+		*n = 28;
+		return true;
+	case 0x83:                      /* GET_NTB_FORMAT: NTB16 */
+	case 0x89:                      /* GET_CRC_MODE: none */
+		ud_put16(data, 0);
+		*n = 2;
+		return true;
+	case 0x85:                      /* GET_NTB_INPUT_SIZE */
+		ud_put32(data, UD_NTB_MAX);
+		*n = 4;
+		return true;
+	case 0x87:                      /* GET_MAX_DATAGRAM_SIZE */
+		ud_put16(data, ETHER_MAX_LEN - ETHER_CRC_LEN);
+		*n = 2;
+		return true;
+	case 0x84:                      /* SET_NTB_FORMAT (NTB16 is all there is) */
+	case 0x86:                      /* SET_NTB_INPUT_SIZE: ours (one datagram) always fits */
+	case 0x88:                      /* SET_MAX_DATAGRAM_SIZE */
+	case 0x8a:                      /* SET_CRC_MODE */
+	case 0x43:                      /* SET_ETHERNET_PACKET_FILTER */
+		return true;
+	default:
+		return length == 0;
+	}
+}
