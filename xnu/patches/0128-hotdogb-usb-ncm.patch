+ * CDC-NCM (hotdogb default, sweetusbncm=0/1 to choose): Windows 10/11 have
+ * no ECM driver (the 7T's host is a Windows PC: it read every descriptor,
+ * found no driver and never sent SET_CONFIGURATION) but bind their inbox
+ * UsbNcm driver to an NCM function; Linux (cdc_ncm) and macOS drive NCM as
+ * well. Windows only enumerates interfaces of a composite device
+ * (usbccgp), so the device is class EF/02/01 with an IAD, and the function
+ * also carries the MS OS 1.0 compatible ID "WINNCM". bcdDevice 2.00 makes
+ * Windows ask for the OS descriptor again (it caches the answer per
+ * VID/PID/bcdDevice). Framing: NTB16, one datagram per IN transfer, any
+ * number per OUT transfer (Linux drivers/usb/gadget/function/f_ncm.c).
+ */
+static const uint8_t ud_ncm_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0xef, 0x02, 0x01, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x02, 1, 2, 3, 1,
+};
+static const uint8_t ud_ncm_cfg_desc[94] = {
+	9, 2, 94, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	8, 0x0b, 0, 2, 0x02, 0x0d, 0x00, 0,             /* IAD: interfaces 0-1, CDC NCM */
+	9, 4, 0, 0, 1, 0x02, 0x0d, 0x00, 0,             /* comm interface 0: CDC NCM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	6, 0x24, 0x1a, 0x00, 0x01, 0x00,                /* NCM 1.00, no optional requests */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x01, 0,             /* data interface 1 alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x01, 0,             /* data interface 1 alt 1: NTB bulk pair */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
