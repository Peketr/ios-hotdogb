+/* NCM: every datagram of one NTB16 (NTH16, then a chain of NDP16s). */
+static void
+ud_rx_ntb(const uint8_t *b, uint32_t len)
+{
+	if (len < 12 || ud_get32(b) != NCM_NTH16_SIG || ud_get16(b + 4) != 12) {
+		if (ud.ntb_bad++ < 10) {
+			printf("SWEET USB: NCM: bad NTH16 (len %u, %02x %02x %02x %02x)\n", len,
+			    len > 0 ? b[0] : 0, len > 1 ? b[1] : 0, len > 2 ? b[2] : 0, len > 3 ? b[3] : 0);
+		}
+		return;
+	}
+	uint32_t blk = ud_get16(b + 8), ndp = ud_get16(b + 10);
+	if (blk == 0 || blk > len) {
+		blk = len;
+	}
+	for (unsigned guard = 0; ndp != 0 && guard < 8; guard++) {
+		if ((ndp & 3) || ndp + 16 > blk || ud_get32(b + ndp) != NCM_NDP16_SIG) {
+			if (ud.ntb_bad++ < 10) {
+				printf("SWEET USB: NCM: bad NDP16 at %u (block %u)\n", ndp, blk);
+			}
+			return;
+		}
+		uint32_t nlen = ud_get16(b + ndp + 4), next = ud_get16(b + ndp + 6);
+		if (nlen < 16 || ndp + nlen > blk) {
+			return;
+		}
+		for (uint32_t e = ndp + 8; e + 4 <= ndp + nlen; e += 4) {
+			uint32_t di = ud_get16(b + e), dl = ud_get16(b + e + 2);
+			if (di == 0 || dl == 0) {
+				break;
+			}
+			if (di + dl > blk) {
+				break;
+			}
+			ud_rx_frame(b + di, dl);
+		}
+		ndp = next;
+	}
+}
