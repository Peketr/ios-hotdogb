+#define UD_MS_VENDOR    0x01            /* bMS_VendorCode in the 0xEE string */
+#define UD_NTB_MAX      0x800           /* dwNtbIn/OutMaxSize = the RX/TX buffers */
+#define UD_NTB_HDR      28              /* NTH16 (12) + NDP16 with one entry (16) */
+#define NCM_NTH16_SIG   0x484d434eu     /* "NCMH" */
