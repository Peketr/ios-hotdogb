+/*
+ * NCM: CONNECTION_SPEED_CHANGE (480 Mb/s each way) first, then
+ * NETWORK_CONNECTION when it completes (one notification at a time), as
+ * f_ncm does; ECM: the connection only.
+ */
+static void
+ud_notify_connected(void)
+{
+	if (!ud_ncm) {
+		ud_notify_connection();
+		return;
+	}
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x2a;       /* CONNECTION_SPEED_CHANGE */
+	ud_put16(n + 2, 0);
+	ud_put16(n + 4, 0);             /* interface 0 */
+	ud_put16(n + 6, 8);
+	ud_put32(n + 8, 480000000u);    /* DLBitRate */
+	ud_put32(n + 12, 480000000u);   /* ULBitRate */
+	ud.notify_pending = true;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 16, TRBCTL_NORMAL);
+}
