+/* ---- 0152: panel brightness over DSI0's command DMA ---- */
+
+static inline uint32_t
+sweet_dsi_rd(volatile uint8_t *b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+static inline void
+sweet_dsi_wr(volatile uint8_t *b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * One DCS long write (data type 0x39, last packet) in high speed. Registers (DSI 6G): CTRL 0x004 (bit 2
+ * CMD_MODE_EN, bit 0 EN), CMD_DMA_CTRL 0x03c (bit 28 from memory, bit 26 low power), DMA_BASE 0x048, DMA_LEN
+ * 0x04c, TRIG_CTRL 0x084 (bits 2:0 DMA trigger, 4 = software), TRIG_DMA 0x090, INT_CTRL 0x110 (bit 0 DMA done,
+ * write 1 to clear). The packet is 4 bytes of header (word count, type, flags) and the payload, padded with
+ * 0xff to a 4-byte multiple. Waits up to 50 ms for DMA done. Called with fBlLock held.
+ */
+bool
+AppleCLCD::dsiDcsWrite(const uint8_t *payload, uint32_t len)
+{
+	if (fDsi == NULL || fDsiCmd == NULL || len == 0 || len > 60) {
+		return false;
+	}
+	uint8_t pkt[64];
+	memset(pkt, 0xff, sizeof(pkt));
+	pkt[0] = (uint8_t)len;
+	pkt[1] = (uint8_t)(len >> 8);
+	pkt[2] = 0x39;
+	pkt[3] = 0xc0;                  /* last | long */
+	memcpy(pkt + 4, payload, len);
+	uint32_t size = (4 + len + 3) & ~3u;
+	for (uint32_t i = 0; i < size / 4; i++) {
+		uint32_t w;
+		memcpy(&w, pkt + 4 * i, 4);
+		fDsiCmd[i] = w;
+	}
+	uint32_t ctrl = sweet_dsi_rd(fDsi, 0x004), trig = sweet_dsi_rd(fDsi, 0x084), dma = sweet_dsi_rd(fDsi, 0x03c);
+	if ((trig & 7) != 4) {
+		sweet_dsi_wr(fDsi, 0x084, (trig & ~7u) | 4);
+	}
+	if ((ctrl & 5) != 5) {
+		sweet_dsi_wr(fDsi, 0x004, ctrl | 5);
+	}
+	sweet_dsi_wr(fDsi, 0x110, sweet_dsi_rd(fDsi, 0x110) | 1);
+	sweet_dsi_wr(fDsi, 0x048, (uint32_t)SWEET_DSI_CMD_PA);
+	sweet_dsi_wr(fDsi, 0x04c, size);
+	sweet_dsi_wr(fDsi, 0x03c, (dma & ~(1u << 26)) | (1u << 28));
+	sweet_dsi_wr(fDsi, 0x090, 1);
+	bool done = false;
+	for (int i = 0; i < 50 && !done; i++) {
+		done = (sweet_dsi_rd(fDsi, 0x110) & 1) != 0;
+		if (!done) {
+			IODelay(1000);
+		}
+	}
+	sweet_dsi_wr(fDsi, 0x110, sweet_dsi_rd(fDsi, 0x110) | 1);
+	sweet_dsi_wr(fDsi, 0x03c, dma);
+	if ((ctrl & 5) != 5) {
+		sweet_dsi_wr(fDsi, 0x004, ctrl);
+	}
+	if ((trig & 7) != 4) {
+		sweet_dsi_wr(fDsi, 0x084, trig);
+	}
+	return done;
+}
+
+/* level 0 = dark (display off), else 1..SWEET_BL_MAX_LEVEL */
+void
+AppleCLCD::setPanelLevel(uint32_t level)
+{
+	if (fDsi == NULL) {
+		return;
+	}
+#if SWEET_BL
+	if (level > SWEET_BL_MAX_LEVEL) {
+		level = SWEET_BL_MAX_LEVEL;
+	}
+#endif
+	uint8_t cmd[3] = { 0x51, (uint8_t)((level >> 8) & 3), (uint8_t)level };
+	IOLockLock(fBlLock);
+	bool done = dsiDcsWrite(cmd, sizeof(cmd));
+	IOLockUnlock(fBlLock);
+	static uint32_t logs, first = 1;
+	if (first && done) {
+		first = 0;
+		IOLog("#### FIRST PANEL BRIGHTNESS COMMAND SENT (LEVEL %#x)\n", level);
+	}
+	if (logs++ < 12 || !done) {
+		IOLog("SWEET FB: panel level %#x: %s\n", level, done ? "done" : "NO DMA DONE");
+	}
+}
+
+/* iOS nits in 16.16 -> panel level; applied unless the display is off */
+void
+AppleCLCD::setBrightnessNits(uint64_t v)
+{
+#if SWEET_BL
+	setProperty("IOMFBBrightnessLevel", v, 32);
+	uint64_t level = (v * SWEET_BL_MAX_LEVEL + ((uint64_t)SWEET_BL_MAX_NITS << 15)) / ((uint64_t)SWEET_BL_MAX_NITS << 16);
+	level = level < 1 ? 1 : (level > SWEET_BL_MAX_LEVEL ? SWEET_BL_MAX_LEVEL : level);
+	IOLockLock(fLock);
+	fBlLevel = (uint32_t)level;
+	bool off = fPowerOff;
+	IOLockUnlock(fLock);
+	if (!off) {
+		setPanelLevel((uint32_t)level);
+	}
+#else
+	(void)v;
+#endif
+}
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	OSNumber *n = d ? OSDynamicCast(OSNumber, d->getObject("IOMFBBrightnessLevel")) : NULL;
+	if (n == NULL || fDsi == NULL) {
+		return kIOReturnUnsupported;
+	}
+	setBrightnessNits(n->unsigned64BitValue());
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	OSNumber *n = d ? OSDynamicCast(OSNumber, d->getObject("brightness-nits")) : NULL;
+	static uint32_t logs;
+	if (d != NULL && logs++ < 6) {
+		IOLog("SWEET BL: backlight set %u keys, brightness-nits %llu\n", d->getCount(),
+		    n ? n->unsigned64BitValue() : 0ULL);
+	}
+	if (n != NULL && fFB != NULL) {
+		uint64_t v = n->unsigned64BitValue();
+		fFB->setBrightnessNits(v < 0x10000 ? v << 16 : v);     /* plain nits or 16.16 */
+		setProperty("brightness-nits", n);
+	}
+	return kIOReturnSuccess;
+}
