+/* 0175: the present thread: one panel copy per vsync kick, always of the latest swapped frame. */
+void
+AppleCLCD::presentThread(void *arg, wait_result_t wr)
+{
+	AppleCLCD *fb = (AppleCLCD *)arg;
+	for (;;) {
+		fb->presentPending();
+	}
+}
+
+void
+AppleCLCD::presentPending(void)
+{
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		IOSleep(10);
+		return;
+	}
+	IOLockLock(fLock);
+	while (!fPresentKick) {
+		IOLockSleep(fLock, &fPresentKick, THREAD_UNINT);
+	}
+	fPresentKick = false;
+	bool go = fDirty && !fPowerOff;
+	if (go) {
+		memcpy(rec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+		fPresentBusy = true;
+	}
+	IOLockUnlock(fLock);
+	if (go) {
+		uint64_t t0 = mach_absolute_time();
+		present(rec);
+		fStatPresentAbs += mach_absolute_time() - t0;
+		fStatPresents++;
+		IOLockLock(fLock);
+		fPresentBusy = false;
+		IOLockUnlock(fLock);
+	}
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
