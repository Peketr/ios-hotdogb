+/*
+ * 0148: read-only access to any GPT partition on LUN 0-7 by name, for the file
+ * server's PARTS/PART commands (sweet_files.c): firmware and the modem's EFS
+ * partitions on hotdogb, where neither Android nor TWRP is available. Only
+ * READ(10) is issued on a foreign LUN; su.lun is restored before the lock is
+ * dropped.
+ */
+#define UFS_MAX_LUN     8
+
+/* Try a command up to 3 times: the first one to a LUN may report a unit attention. */
+static int
+ufs_read_gpt_retry(const char *want, uint64_t *first, uint64_t *n)
+{
+	int err = EIO;
+	for (int i = 0; i < 3; i++) {
+		err = ufs_find_partition_range(want, first, n);
+		if (err != EIO) {
+			break;
+		}
+	}
+	return err;
+}
+
+int sweet_ufs_part_find(const char *name, uint8_t *lun, uint64_t *first, uint64_t *nblocks);
+
+int
+sweet_ufs_part_find(const char *name, uint8_t *lun, uint64_t *first, uint64_t *nblocks)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	int err = ENOENT;
+	lck_mtx_lock(&sweet_ufs_lock);
+	ufs_gpt_quiet = true;
+	for (uint8_t l = 0; l < UFS_MAX_LUN; l++) {
+		su.lun = l;
+		if (ufs_read_gpt_retry(name, first, nblocks) == 0) {
+			*lun = l;
+			err = 0;
+			break;
+		}
+	}
+	ufs_gpt_quiet = false;
+	su.lun = UFS_HOME_LUN;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return err;
+}
+
+/* len bytes at byte offset off of a partition (as found above) into dst; len <= 512 KiB. */
+int sweet_ufs_part_read(uint8_t lun, uint64_t first, uint64_t nblocks, uint64_t off, void *dst, uint32_t len);
+
+int
+sweet_ufs_part_read(uint8_t lun, uint64_t first, uint64_t nblocks, uint64_t off, void *dst, uint32_t len)
+{
+	if (!su.ready || lun >= UFS_MAX_LUN || len == 0 || len > BOUNCE_SIZE / 2) {
+		return EINVAL;
+	}
+	uint64_t size = nblocks * UFS_BLOCK;
+	if (off >= size || len > size - off) {
+		return EINVAL;
+	}
+	uint64_t lba = first + off / UFS_BLOCK;
+	uint32_t skip = (uint32_t)(off % UFS_BLOCK);
+	uint32_t count = (skip + len + UFS_BLOCK - 1) / UFS_BLOCK;
+	lck_mtx_lock(&sweet_ufs_lock);
+	su.lun = lun;
+	int err = ufs_read_blocks(lba, count);
+	if (err == EIO) {
+		err = ufs_read_blocks(lba, count);      /* unit attention on the first command */
+	}
+	su.lun = UFS_HOME_LUN;
+	if (!err) {
+		memcpy(dst, (const uint8_t *)(su.dma + DMA_BOUNCE) + skip, len);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return err;
+}
+
+/* Text list "name lun first_block blocks\n" of every partition on every LUN; returns its length. */
+int sweet_ufs_part_list(char *out, uint32_t max, uint32_t *used);
+
+int
+sweet_ufs_part_list(char *out, uint32_t max, uint32_t *used)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint32_t n = 0;
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint8_t l = 0; l < UFS_MAX_LUN; l++) {
+		su.lun = l;
+		int err = ufs_read_blocks(1, 1);
+		if (err == EIO) {
+			err = ufs_read_blocks(1, 1);
+		}
+		if (err || memcmp(b, "EFI PART", 8) != 0) {
+			continue;
+		}
+		uint64_t entry_lba;
+		uint32_t nent, esz;
+		memcpy(&entry_lba, b + 72, 8);
+		memcpy(&nent, b + 80, 4);
+		memcpy(&esz, b + 84, 4);
+		if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE ||
+		    ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK)) {
+			continue;
+		}
+		for (uint32_t i = 0; i < nent && n + 80 < max; i++) {
+			const uint8_t *e = b + i * esz;
+			uint64_t f, last;
+			memcpy(&f, e + 32, 8);
+			memcpy(&last, e + 40, 8);
+			if (f == 0 || last < f) {
+				continue;
+			}
+			char name[37];
+			unsigned c;
+			for (c = 0; c < 36; c++) {
+				uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+				if (ch == 0 || ch > 0x7f || ch <= ' ') {
+					break;
+				}
+				name[c] = (char)ch;
+			}
+			name[c] = 0;
+			n += (uint32_t)snprintf(out + n, max - n, "%s %u %llu %llu\n", c ? name : "-", l, f, last - f + 1);
+		}
+	}
+	su.lun = UFS_HOME_LUN;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	*used = MIN(n, max);
+	return 0;
+}
