+/* 0148: raw, read-only partition bytes (sweet_ufs.c), for firmware without Android/TWRP. */
+static int
+sf_part(socket_t so, const char *name, uint64_t off, uint64_t len)
+{
+	uint8_t lun = 0;
+	uint64_t first = 0, nblocks = 0;
+	int err = sweet_ufs_part_find(name, &lun, &first, &nblocks);
+	uint64_t size = nblocks * 4096;
+	if (!err && (off > size || len > size - off)) {
+		err = EINVAL;
+	}
+	if (err) {
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	if (len == 0) {
+		len = size - off;
+	}
+	printf("SWEET FILES: PART %s: LUN %u blocks %llu+%llu, %llu bytes at %llu\n", name, lun, first, nblocks, len, off);
+	sf_reply(so, 0, len, true);
+	for (uint64_t done = 0; done < len && !err;) {
+		uint32_t chunk = (uint32_t)MIN((uint64_t)SF_BUF, len - done);
+		err = sweet_ufs_part_read(lun, first, nblocks, off + done, sf_buf, chunk);
+		if (!err) {
+			err = sf_send(so, sf_buf, chunk);
+		}
+		done += chunk;
+	}
+	return err;
+}
+
+static int
+sf_parts(socket_t so)
+{
+	uint32_t used = 0;
+	int err = sweet_ufs_part_list(sf_buf, SF_BUF, &used);
+	sf_reply(so, err, used, true);
+	if (!err && used) {
+		err = sf_send(so, sf_buf, used);
+	}
+	return err;
+}
