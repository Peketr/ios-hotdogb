+/*
+ * 0145: write the console log to disk now and wait for it (thread context,
+ * interrupts on). For markers right before a suspected hardware reset, where
+ * sweet_log_kick's wakeup may not get the log thread scheduled in time.
+ */
+int sweet_log_sync(void);
+
+int
+sweet_log_sync(void)
+{
+	if (!sweet_log_running || !su.ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = sweet_log_flush_locked();
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
 /* Flush the console log now (debug markers before a suspected reset). */
 void sweet_log_kick(void);
 
