@@ -880,6 +880,17 @@
 	return (uint64_t)hi2 << 32 | lo;
 }
 
+/* 0180: GPU core clock cycles (CP perf counter 0, CP_PERFCTR_CP_SEL[0] = always count); 0 with GX off */
+uint64_t a6_gpu_cycles(void)
+{
+	if (!a6_gx_up())
+		return 0;
+	uint32_t hi = rd32(GREG(0x0401)), lo = rd32(GREG(0x0400)), hi2 = rd32(GREG(0x0401));
+	if (hi2 != hi)
+		lo = rd32(GREG(0x0400));
+	return (uint64_t)hi2 << 32 | lo;
+}
+
 bool a6_fence_done(const struct a6_gpu *g, uint32_t fence)
 {
 	return (int32_t)(a6_fence_read(g) - fence) >= 0;
