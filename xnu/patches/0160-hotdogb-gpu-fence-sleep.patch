  * stamp ring (A6_TS_SLOTS) before they are summed only count as "missed".
  */
 #define GSTAT_OWNERS    6
+
+/*
+ * 0160: fence waits used to spin on delay(20) for as long as the GPU worked (10-15 ms per backboardd frame):
+ * the k0159 sample burst had backboardd's render thread running in IOConnectCallStructMethod (Turnip's
+ * WaitFence) for about half a core. Now: spin for the first sweetgpuspin us (default 100, short jobs), then
+ * sleep in sweetgpusleep us slices (default 200; 0 = spin always, as before). t0: when the wait began.
+ */
+extern int get_preemption_level(void);
+static uint32_t fence_spin_us = 100, fence_sleep_us = 200, fence_sleeps, fence_opts_read;
+
+static void
+gpu_pause(uint64_t t0)
+{
+	uint64_t ns, deadline;
+	if (!fence_opts_read) {
+		PE_parse_boot_argn("sweetgpuspin", &fence_spin_us, sizeof(fence_spin_us));
+		PE_parse_boot_argn("sweetgpusleep", &fence_sleep_us, sizeof(fence_sleep_us));
+		fence_opts_read = 1;
+		a6_log("#### GPU FENCE WAIT: spin %u us, then sleep %u us slices\n", fence_spin_us, fence_sleep_us);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if (fence_sleep_us == 0 || ns < fence_spin_us * 1000ULL || ml_at_interrupt_context() ||
+	    get_preemption_level() != 0) {
+		delay(20);
+		return;
+	}
+	clock_interval_to_deadline(fence_sleep_us, NSEC_PER_USEC, &deadline);
+	(void)assert_wait_deadline((event_t)&fence_sleeps, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+	fence_sleeps++;
+}
