+/*
+ * Let another driver's DMA stream use the translation-off bank set up above
+ * (hotdogb: the touch GPI engine, stream 0x7b6), through this driver's
+ * existing SMMU mapping: kernels 0131-0135 reset the phone when the touch
+ * driver mapped 0x15000000 a second time. Returns the SMR index, or -1.
+ */
+int sweet_usb_smmu_share(uint32_t sid);
+
+int
+sweet_usb_smmu_share(uint32_t sid)
+{
+	vm_offset_t as = ud_smmu_as;
+	if (!as || ud_smmu_cbn < 0) {
+		printf("SWEET USB: SMMU share %#x: no USB bank\n", sid);
+		return -1;
+	}
+	unsigned nsmr = *(volatile uint32_t *)(as + 0x20) & 0xff;
+	int free_smr = -1;
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t m = *(volatile uint32_t *)(as + 0x800 + 4 * i);
+		if (!(m >> 31)) {
+			if (free_smr < 0) {
+				free_smr = (int)i;
+			}
+			continue;
+		}
+		if (((sid ^ (m & 0x7fff)) & ~((m >> 16) & 0x7fff) & 0x7fff) == 0) {
+			printf("SWEET USB: SMMU share %#x: smr%u %x already matches (s2cr %x)\n", sid, i, m,
+			    *(volatile uint32_t *)(as + 0xc00 + 4 * i));
+			return -1;
+		}
+	}
+	if (free_smr < 0) {
+		printf("SWEET USB: SMMU share %#x: no free SMR\n", sid);
+		return -1;
+	}
+	*(volatile uint32_t *)(as + 0xc00 + 4 * free_smr) = (uint32_t)ud_smmu_cbn;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(as + 0x800 + 4 * free_smr) = (1u << 31) | (sid & 0x7fff);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET USB: SMMU share smr%d %x s2cr %x -> cb%d (translation off)\n", free_smr,
+	    *(volatile uint32_t *)(as + 0x800 + 4 * free_smr), *(volatile uint32_t *)(as + 0xc00 + 4 * free_smr),
+	    ud_smmu_cbn);
+	return free_smr;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
