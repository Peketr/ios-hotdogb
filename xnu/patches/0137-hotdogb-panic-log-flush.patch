+/*
+ * Panic path (osfmk/arm/model_dep.c: SavePanicInfo, paniclog_flush): the
+ * panic string and backtraces are already in the ring (patch 0098), but the
+ * log thread will never run again and the 7T's RAM does not survive the
+ * reset, so write the ring now, polled (interrupts are off, so ufs_scsi
+ * spins). No mutex: a stopped CPU may hold it. Slot 0 may still hold that
+ * CPU's command: wait for it, else clear it. Each call writes only what is
+ * new; at most a few calls (nested panics).
+ */
+void sweet_log_panic_flush(void);
+
+void
+sweet_log_panic_flush(void)
+{
+	static int entries;
+	if (!sweet_log_running || !su.ready || ++entries > 4) {
+		return;
+	}
+	sweet_ufs_panicking = true;
+	uint64_t now = mach_absolute_time(), deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += now;
+	while ((ufs_rd(REG_UTRLDBR) & 1) && mach_absolute_time() < deadline) {
+		delay(10);
+	}
+	if (ufs_rd(REG_UTRLDBR) & 1) {
+		ufs_wr(REG_UTRLCLR, ~1u);
