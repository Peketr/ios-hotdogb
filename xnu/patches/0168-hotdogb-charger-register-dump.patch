 #if SWEET_HOTDOGB
+/*
+ * Read-only dump of the PM8150B SMB5 blocks (SID 2): CHGR 0x10, DCDC 0x11,
+ * BATIF 0x12, USBIN 0x13, MISC 0x16, 0x00-0x7f of each (status, interrupt
+ * status, config). For working out why the charger reports state 7 (charging
+ * disabled) under iOS. "--" = read failed.
+ */
+void
+SweetBattery::smbDump(const char *why)
+{
+	if (!fSpmi) {
+		return;
+	}
+	static const uint8_t blocks[] = {0x10, 0x11, 0x12, 0x13, 0x16};
+	IOLog("#### CHARGER REGISTER DUMP (%s)\n", why);
+	for (unsigned b = 0; b < sizeof(blocks); ++b) {
+		for (unsigned row = 0; row < 0x80; row += 16) {
+			char line[16 * 3 + 1];
+			for (unsigned i = 0; i < 16; ++i) {
+				uint8_t v = 0;
+				static const char hex[] = "0123456789abcdef";
+				bool ok = !sweet_spmi_read(2, ((unsigned)blocks[b] << 8) | (row + i), &v);
+				line[i * 3] = ' ';
+				line[i * 3 + 1] = ok ? hex[v >> 4] : '-';
+				line[i * 3 + 2] = ok ? hex[v & 15] : '-';
+			}
+			line[sizeof(line) - 1] = 0;
+			IOLog("SWEET SMB5 %02x%02x:%s\n", blocks[b], row, line);
+		}
+	}
+}
+
 /*
  * One gauge sample (workloop thread). SOC, voltage, average current (mA,
  * positive = charging, as IOPMPowerSource), remaining / full charge capacity
@@ -705,6 +737,9 @@ SweetBattery::pollGauge(void)
 		    soc, volt, ma, rm, fcc, flags, fTempCenti, usb, path, charger,
 		    external, charging, full);
 	}
+	if (first || external != fLastExternal) {
+		smbDump(first ? "first reading" : external ? "charger connected" : "charger disconnected");
+	}
 	if (external != fLastExternal && !first) {
 		IOLog("#### CHARGER %s (%u%%)\n", external ? "CONNECTED" : "DISCONNECTED", soc);
 	}
