 /*
- * SE interface selection (QUPv3 SE register map, as written by Linux's GENI
- * firmware loader, qcom-geni-se.c): GENI_IF_DISABLE_RO (SE_FIFO_OFF) bit 0
- * mirrors SE_FIFO_IF_DISABLE bit 0. On the 7T, XBL/Android leave the touch SE
- * GSI-only; clearing it selects FIFO mode with the same loaded I2C firmware.
+ * GENI_IF_DISABLE_RO (SE_FIFO_OFF) bit 0: the SE was set up GSI-only (FIFO
+ * interface off) when its firmware was loaded, as the 7T's touch SE is
+ * (Android drives it with GPI DMA). The register that selects it,
+ * SE_FIFO_IF_DISABLE at SE + 0x2008, is not reachable from the kernel: any
+ * access to SE + 0x2000.. (kernel 0128, patch 0127) reset the phone at once,
+ * a TrustZone access violation. Never touch that region; touch here needs GSI.
  */
-#define SE_CLK_CTRL     0x2000u
-#define SE_DMA_IF_EN    0x2004u
-#define SE_FIFO_IF_DIS  0x2008u
