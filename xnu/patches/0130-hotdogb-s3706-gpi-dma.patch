+/* ---- GPI DMA (GSI mode) ---- */
+
+/*
+ * apps SMMU (0x15000000) stage-1 bypass bank for the GPI's stream 0x7b6, so
+ * the engine reaches the physical ring/buffer addresses we program. Same
+ * "translation off, as ABL" bank sweet_usb.c uses for the DWC3 stream.
+ */
+static int
+s3_gpi_smmu(void)
+{
+	vm_offset_t as = ml_io_map(0x15000000ull, 0x100000);
+	if (!as) {
+		return -1;
+	}
+	uint32_t idr0 = s3_rd(as, 0x20), idr1 = s3_rd(as, 0x24);
+	unsigned nsmr = idr0 & 0xffu, ncb = idr1 & 0xffu;
+	uint32_t pagesz = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	uint32_t cbbase = (1u << (((idr1 >> 28) & 7u) + 1u)) * pagesz;
+	uint64_t used[2] = {0, 0};
+	int smr = -1, cb = -1;
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t m = s3_rd(as, 0x800 + 4 * i), c = s3_rd(as, 0xc00 + 4 * i);
+		if (!(m >> 31)) {
+			if (smr < 0) {
+				smr = (int)i;
+			}
+			continue;
+		}
+		if (((c >> 16) & 3u) == 0) {
+			used[(c & 0xffu) / 64] |= 1ull << ((c & 0xffu) % 64);
+		}
+		if (((GPI_SMMU_SID ^ (m & 0x7fffu)) & ~((m >> 16) & 0x7fffu) & 0x7fffu) == 0) {
+			printf("SWEET S3706: SMMU smr%u already matches %#x (s2cr %#x)\n", i, GPI_SMMU_SID, c);
+			return -1;
+		}
+	}
+	for (int c = 0; c < (int)ncb; c++) {
+		if (!(used[c / 64] & (1ull << (c % 64))) && !(s3_rd(as, cbbase + c * pagesz) & 1u) &&
+		    s3_rd(as, pagesz + 4 * c) == 0) {
+			cb = c;
+			break;
+		}
+	}
+	if (smr < 0 || cb < 0) {
+		printf("SWEET S3706: SMMU: no free smr/cb (%d/%d)\n", smr, cb);
+		return -1;
+	}
+	vm_offset_t cbv = as + cbbase + cb * pagesz;
+	*(volatile uint32_t *)(cbv + 0x00) = 0xe0u;                     /* SCTLR: M=0 (translation off) */
+	*(volatile uint32_t *)(as + pagesz + 0x800 + 4 * cb) = 1u;      /* CBA2R: AArch64 */
+	*(volatile uint32_t *)(as + pagesz + 4 * cb) = 0x1f000u;        /* CBAR as ABL's banks */
+	__asm__ volatile("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(as + 0xc00 + 4 * smr) = (uint32_t)cb;
+	*(volatile uint32_t *)(as + 0x800 + 4 * smr) = (1u << 31) | GPI_SMMU_SID;
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET S3706: SMMU smr%d %#x -> cb%d (translation off)\n", smr,
+	    s3_rd(as, 0x800 + 4 * smr), cb);
+	return 0;
+}
+
+/* Issue a channel/event command and wait for the expected CNTXT_0 state. */
+static bool
+s3_gpi_cmd(uint32_t cmdreg, uint32_t cntxt0, unsigned op, unsigned chid, unsigned want)
+{
+	s3_wr(s3.gpi_regs, cmdreg, (op << 24) | chid);
+	for (unsigned i = 0; i < 2000; i++) {
+		if (((s3_rd(s3.gpi_regs, cntxt0 + GC_CONFIG) >> 20) & 0xfu) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	printf("SWEET S3706: GPI cmd op %u ch %u -> state %#x (want %u)\n", op, chid,
+	    (s3_rd(s3.gpi_regs, cntxt0 + GC_CONFIG) >> 20) & 0xfu, want);
+	return false;
+}
+
+/* Program a channel's CNTXT registers to point at a ring in our DMA block. */
+static void
+s3_gpi_ring(uint32_t cntxt, uint32_t db, uint32_t cfg0, unsigned off, unsigned len)
+{
+	uint64_t pa = s3.dma_pa + off;
+	s3_wr(s3.gpi_regs, cntxt + GC_CONFIG, cfg0);
+	s3_wr(s3.gpi_regs, cntxt + GC_LENGTH, len);
+	s3_wr(s3.gpi_regs, cntxt + GC_BASE_LSB, (uint32_t)pa);
+	s3_wr(s3.gpi_regs, cntxt + GC_BASE_MSB, (uint32_t)(pa >> 32));
+	s3_wr(s3.gpi_regs, db + 4, (uint32_t)(pa >> 32));
+}
+
+static void
+s3_gpi_se_mode(void)
+{
+	/* geni_se_select_gpi_mode, all below SE + 0x2000 (the forbidden region). */
+	s3_wr(s3.se, 0xe18, 0);                  /* SE_GSI_EVENT_EN */
+	s3_wr(s3.se, 0x618, 0xffffffffu);        /* M_IRQ_CLEAR */
+	s3_wr(s3.se, 0x648, 0xffffffffu);        /* S_IRQ_CLEAR */
+	s3_wr(s3.se, 0xc44, 0xffffffffu);        /* DMA_TX_IRQ_CLR */
+	s3_wr(s3.se, 0xd44, 0xffffffffu);        /* DMA_RX_IRQ_CLR */
+	s3_wr(s3.se, 0xe1c, 0xffffffffu);        /* SE_IRQ_EN */
+	s3_wr(s3.se, 0xe1c, 0);
+	s3_wr(s3.se, 0x614, s3_rd(s3.se, 0x614) & ~0x4c000001u); /* clear CMD_DONE, TX/RX WM, RX_LAST */
+	s3_wr(s3.se, 0x258, 1);                  /* SE_GENI_DMA_MODE_EN */
+	s3_wr(s3.se, 0xe18, s3_rd(s3.se, 0xe18) | 0xfu); /* DMA_TX/RX + M/S event en */
+	/* qcom_geni_i2c_conf: XO level 0, 400 kHz (same regs the FIFO path used). */
+	s3_wr(s3.se, SE_CLK_SEL, 0);
+	s3_wr(s3.se, SE_MCLK, I2C_MCLK);
+	s3_wr(s3.se, SE_I2C_SCL, I2C_SCL);
+}
+
+static bool
+s3_gpi_setup(void)
+{
+	s3.gpi_regs = ml_io_map(GPI_PA, GPI_SIZE);
+	if (!s3.gpi_regs) {
+		printf("SWEET S3706: GPI MMIO map failed\n");
+		return false;
+	}
+	if (kmem_alloc_contig(kernel_map, &s3.dma, GD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET S3706: GPI DMA alloc failed\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)s3.dma);
+	if (!pn) {
+		return false;
+	}
+	s3.dma_pa = ptoa_64(pn);
+	if (s3.dma_pa >> 32) {
+		printf("SWEET S3706: GPI DMA above 4 GB (%#llx)\n", s3.dma_pa);
+		return false;
+	}
+	if (s3_gpi_smmu() != 0) {
+		return false;
+	}
+	s3_gpi_se_mode();
+
+	/* No GPII interrupt: mask every source, we poll. */
+	s3_wr(s3.gpi_regs, G_TYPE_IRQ_MSK, 0);
+	s3_wr(s3.gpi_regs, G_CH_IRQ_MSK, 0);
+	s3_wr(s3.gpi_regs, G_EV_IRQ_MSK, 0);
+	s3_wr(s3.gpi_regs, G_IEOB_IRQ_MSK, 0);
+	s3_wr(s3.gpi_regs, G_GLOB_IRQ_EN, 0);
+	s3_wr(s3.gpi_regs, G_GPII_IRQ_EN, 0);
+	s3_wr(s3.gpi_regs, G_INTSET, 1);
+
+	/* Event ring: allocate, then program CNTXT (EL_SIZE 16, INTYPE 1, CHTYPE 2). */
+	if (!s3_gpi_cmd(G_EV_CMD, G_EV_CNTXT, GPI_OP_ALLOC, 0, GPI_ST_ALLOCATED)) {
+		return false;
+	}
+	s3_gpi_ring(G_EV_CNTXT, G_EV_DB, 0x10010002u, GD_EV_RING, GD_EV_LEN);
+	s3_wr(s3.gpi_regs, G_EV_CNTXT + GC_INT_MOD, 0);
+	s3_wr(s3.gpi_regs, G_EV_CNTXT + GC_MSI_LSB, 0);
+	s3_wr(s3.gpi_regs, G_EV_CNTXT + GC_RP_UPD_LSB, 0);
+	/* Prime: wp = base + len - 16, ring the event doorbell. */
+	s3.ev_rp = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	s3_wr(s3.gpi_regs, G_EV_DB, (uint32_t)(s3.dma_pa + GD_EV_RING + GD_EV_LEN - 16));
+
+	/* TX channel 0 (DIR_OUT) and RX channel 1 (DIR_IN). */
+	if (!s3_gpi_cmd(G_CH_CMD, G_CH_CNTXT(GPI_CH_TX), GPI_OP_ALLOC, GPI_CH_TX, GPI_ST_ALLOCATED) ||
+	    !s3_gpi_cmd(G_CH_CMD, G_CH_CNTXT(GPI_CH_RX), GPI_OP_ALLOC, GPI_CH_RX, GPI_ST_ALLOCATED)) {
+		return false;
+	}
+	s3_gpi_ring(G_CH_CNTXT(GPI_CH_TX), G_CH_DB(GPI_CH_TX), 0x1000000au, GD_TX_RING, GD_RING_LEN);
+	s3_gpi_ring(G_CH_CNTXT(GPI_CH_RX), G_CH_DB(GPI_CH_RX), 0x10000002u, GD_RX_RING, GD_RING_LEN);
+	/* SCRATCH_0 = (pair<<16)|(proto<<4)|seid; pair = !chid. */
+	s3_wr(s3.gpi_regs, G_CH_SCR0(GPI_CH_TX), (1u << 16) | (GPI_PROTO_I2C << 4) | GPI_SEID);
+	s3_wr(s3.gpi_regs, G_CH_SCR0(GPI_CH_RX), (GPI_PROTO_I2C << 4) | GPI_SEID);
+	s3_wr(s3.gpi_regs, G_CH_QOS(GPI_CH_TX), 1);
+	s3_wr(s3.gpi_regs, G_CH_QOS(GPI_CH_RX), 1);
+	s3.tx_wp = s3.rx_wp = 0;
+
+	if (!s3_gpi_cmd(G_CH_CMD, G_CH_CNTXT(GPI_CH_TX), GPI_OP_START, GPI_CH_TX, GPI_ST_STARTED) ||
+	    !s3_gpi_cmd(G_CH_CMD, G_CH_CNTXT(GPI_CH_RX), GPI_OP_START, GPI_CH_RX, GPI_ST_STARTED)) {
+		return false;
+	}
+	s3.gpi = true;
+	printf("SWEET S3706: GPI DMA up (GPII %u, dma_pa %#llx)\n", GPII, s3.dma_pa);
+	return true;
+}
+
+/* Append one TRE to a ring, advancing its write pointer. */
+static void
+s3_gpi_push(unsigned ring, unsigned *wp, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(s3.dma + ring + *wp);
+	t[0] = d0; t[1] = d1; t[2] = d2; t[3] = d3;
+	*wp = (*wp + 16u) % GD_RING_LEN;
+}
+
+/* Poll the event ring for an XFER_COMPLETE (EOT/SUCCESS) on channel chid. */
+static int
+s3_gpi_wait(unsigned chid)
+{
+	uint32_t ev_lo = (uint32_t)(s3.dma_pa + GD_EV_RING);
+	for (unsigned i = 0; i < 5000; i++) {
+		flush_dcache64((addr64_t)(s3.dma_pa + GD_EV_RING), GD_EV_LEN, TRUE);
+		uint32_t hw = s3_rd(s3.gpi_regs, G_EV_CNTXT + GC_RP_LSB);
+		unsigned hw_off = (hw - ev_lo) & (GD_EV_LEN - 1u);
+		int found = -1;
+		while (s3.ev_rp != hw_off) {
+			const volatile uint32_t *e = (const volatile uint32_t *)(s3.dma + GD_EV_RING + s3.ev_rp);
+			unsigned type = (e[3] >> 16) & 0xffu, code = (e[2] >> 24) & 0xffu;
+			unsigned ec = (e[3] >> 24) & 0xffu;
+			if (type == EV_TYPE_XFER && (code == EV_CODE_EOT || code == EV_CODE_SUCCESS) && ec == chid) {
+				found = 0;
+			} else if (type == EV_TYPE_XFER && ec == chid) {
+				if (s3.log) {
+					printf("SWEET S3706: GPI xfer ch %u code %#x\n", chid, code);
+				}
+				found = EIO;
+			}
+			s3.ev_rp = (s3.ev_rp + 16u) % GD_EV_LEN;
+		}
+		if (s3.ev_rp != 0 || hw_off != 0) {
+			s3_wr(s3.gpi_regs, G_EV_DB, (uint32_t)(s3.dma_pa + GD_EV_RING + s3.ev_rp));
+			s3_wr(s3.gpi_regs, G_IEOB_IRQ_CLR, 1);
+		}
+		if (found >= 0) {
+			return found;
+		}
+		delay(20);
+	}
+	printf("SWEET S3706: GPI timeout waiting on ch %u\n", chid);
+	return EIO;
+}
+
+/*
+ * One I2C transaction over GPI: write wlen bytes (register + payload), then,
+ * if rlen, a repeated-start read of rlen bytes. The slave address goes in the
+ * GO TRE; the bytes live in the DMA buffers. config0 (clock timing) is issued
+ * once, on the first transaction.
+ */
+static int
+s3_gpi_txn(const uint8_t *wbuf, unsigned wlen, uint8_t *rbuf, unsigned rlen)
+{
+	if (s3.dead || wlen == 0 || wlen > GD_BUF_MAX || rlen > GD_BUF_MAX) {
+		return EIO;
+	}
+	memcpy((void *)(s3.dma + GD_TXBUF), wbuf, wlen);
+	uint32_t txlo = (uint32_t)(s3.dma_pa + GD_TXBUF), rxlo = (uint32_t)(s3.dma_pa + GD_RXBUF);
+
+	if (!s3.cfg_done) {
+		/* CONFIG0: 400 kHz @ 19.2 MHz (tlow 11, thigh 5, tcyl 22), clk_div 2, packed. */
+		s3_gpi_push(GD_TX_RING, &s3.tx_wp, 0x0316050bu, 0, 2, TRE_TYPE_CFG0 | TRE_CHAIN);
+		s3.cfg_done = true;
+	}
+	if (rlen == 0) {
