+/*
+ * The console log's own writes: bounded to the log partition, which on
+ * flame is the root partition (needs ufsrw=1) and on hotdogb is rawdump
+ * (Android's /data fills userdata; rawdump is OnePlus's crash-dump area,
+ * never mounted), so the log works with a read-only root there.
+ */
+static int
+ufs_write_log_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.log_nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba < su.log_first || lba - su.log_first >= su.log_nblocks ||
+	    count > su.log_nblocks - (lba - su.log_first) || lba + count - 1 > UINT32_MAX) {
+		printf("SWEET UFS: refusing log write of %u blocks at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+#if !SWEET_HOTDOGB
+	if (!su.writable) {
+		return EPERM;
+	}
+#endif
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
