+/*
+ * 0155: what CoreBrightness's DisplayCreateWithID reads from the backlight service. Without IODisplayParameters
+ * it logged "failed to create DisplayRef" / "failed to create a display module" (k0154-bl2log, oslog of
+ * backboardd): no display module, no brightness, and libEDR's server never started, so Core Animation's
+ * EDRClient waited on it every frame (the 0.2-0.4 fps). IODisplayParameters = { brightness = { min, max, value } }
+ * (0..SWEET_BL_PARAM_MAX, value at the default nits); then the panel description it reads with the same calls
+ * (lMaxProduct, backlight-marketing-table, use-AAP ...): on an iPhone those are the device tree's /backlight node,
+ * here copied from our ADT's (tools/adt-add-backlight.py: the iPhone X's) onto the service.
+ */
+#define SWEET_BL_PARAM_MAX      65536
+
+static void
+sweet_bl_describe(IOService *bl)
+{
+	OSDictionary *dp = OSDictionary::withCapacity(1), *br = OSDictionary::withCapacity(3);
+	OSNumber *mn = OSNumber::withNumber(0ULL, 32), *mx = OSNumber::withNumber((unsigned long long)SWEET_BL_PARAM_MAX, 32);
+	OSNumber *val = OSNumber::withNumber((unsigned long long)SWEET_BL_PARAM_MAX * SWEET_BL_DEFAULT_NITS / SWEET_BL_MAX_NITS, 32);
+	if (dp != NULL && br != NULL && mn != NULL && mx != NULL && val != NULL) {
+		br->setObject("min", mn);
+		br->setObject("max", mx);
+		br->setObject("value", val);
+		dp->setObject("brightness", br);
+		bl->setProperty("IODisplayParameters", dp);
+	}
+	OSSafeReleaseNULL(dp);
+	OSSafeReleaseNULL(br);
+	OSSafeReleaseNULL(mn);
+	OSSafeReleaseNULL(mx);
+	OSSafeReleaseNULL(val);
+
+	uint32_t copied = 0;
+	IORegistryEntry *dt = IORegistryEntry::fromPath("/backlight", gIODTPlane);
+	OSDictionary *props = dt != NULL ? dt->dictionaryWithProperties() : NULL;
+	OSCollectionIterator *it = props != NULL ? OSCollectionIterator::withCollection(props) : NULL;
+	OSSymbol *k;
+	while (it != NULL && (k = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		const char *name = k->getCStringNoCopy();
+		if (!strcmp(name, "name") || !strcmp(name, "compatible") || !strcmp(name, "device_type") ||
+		    !strcmp(name, "AAPL,phandle") || bl->getProperty(k) != NULL) {
+			continue;
+		}
+		bl->setProperty(k, props->getObject(k));
+		copied++;
+	}
+	OSSafeReleaseNULL(it);
+	OSSafeReleaseNULL(props);
+	OSSafeReleaseNULL(dt);
+	IOLog("SWEET BL: IODisplayParameters brightness 0..%u, %u properties from the device tree's /backlight%s\n",
+	    SWEET_BL_PARAM_MAX, copied, copied ? "" : " (none: no /backlight node in the ADT)");
+}
