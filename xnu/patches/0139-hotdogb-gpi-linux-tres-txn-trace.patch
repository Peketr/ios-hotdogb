+	s3_gpi_push(GD_TX_RING, &s3.tx_wp,
+	    I2C_GO_WRITE | (S3_ADDR << 8) | (rlen ? I2C_GO_STRETCH : 0u), 0, 0, TRE_TYPE_GO | TRE_CHAIN);
+	s3_gpi_push(GD_TX_RING, &s3.tx_wp, txlo, txhi, wlen, TRE_TYPE_DMA | TRE_IEOT);
 	flush_dcache64((addr64_t)(s3.dma_pa + GD_TXBUF), wlen, TRUE);
 	flush_dcache64((addr64_t)(s3.dma_pa + GD_TX_RING), GD_RING_LEN, TRUE);
+	if (dbg) {
+		GPIDBG("txn write TREs queued, ringing TX doorbell");
+	}
+	s3_wr(s3.gpi_regs, G_CH_DB(GPI_CH_TX), (uint32_t)(s3.dma_pa + GD_TX_RING + s3.tx_wp));
