+	}
+	if (err || rlen == 0) {
+		return err;
+	}
+
+	/* Read message: GO(read, len, link_rx, IEOB) on TX; DMA(IEOT) on RX. */
+	s3_gpi_push(GD_RX_RING, &s3.rx_wp, rxlo, rxhi, rlen, TRE_TYPE_DMA | TRE_IEOT);
