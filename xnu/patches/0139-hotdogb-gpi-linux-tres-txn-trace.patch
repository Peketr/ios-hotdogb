@@ -194,6 +194,8 @@
 #define TRE_CHAIN       (1u << 0)
 #define TRE_IEOT        (1u << 9)
 #define TRE_BEI         (1u << 10)
+#define TRE_IEOB        (1u << 8)
+#define TRE_LINK_RX     (1u << 11)
 #define TRE_TYPE_DMA    (0x10u << 16)
