 	if (!s3.cfg_done) {
-		/* CONFIG0 as Linux geni_i2c_gsi_xfer: pack | t_cycle 24 | t_high 5 | t_low 12, clk_div 2. */
+		/* CONFIG0: pack | t_cycle 24 | t_high 5 | t_low 12, clk_div 2. */
 		s3_gpi_push(GD_TX_RING, &s3.tx_wp, 0x0318050cu, 0, 2, TRE_TYPE_CFG0 | TRE_CHAIN);
