-	    TRE_TYPE_GO | TRE_CHAIN);
-	s3_gpi_push(GD_TX_RING, &s3.tx_wp, txlo, txhi, wlen, TRE_TYPE_DMA | TRE_CHAIN);
-	s3_gpi_push(GD_TX_RING, &s3.tx_wp, I2C_GO_READ | (S3_ADDR << 8), 0, rlen, TRE_TYPE_GO);
