+void
+sweet_usb_smmu_status(const char *tag)
+{
+	vm_offset_t as = ud_smmu_as;
+	if (!as) {
+		printf("SWEET USB: SMMU %s: no mapping\n", tag);
+		return;
+	}
+	volatile uint32_t *g = (volatile uint32_t *)as;
+	printf("SWEET USB: SMMU %s: cr0 %x gfsr %x gfsynr0 %x gfsynr1 %x gfar %x%08x", tag,
+	    g[0x00 / 4], g[0x48 / 4], g[0x50 / 4], g[0x54 / 4], g[0x44 / 4], g[0x40 / 4]);
+	if (ud_smmu_cb) {
+		volatile uint32_t *c = (volatile uint32_t *)ud_smmu_cb;
+		printf("; cb%d fsr %x far %x%08x fsynr0 %x", ud_smmu_cbn, c[0x58 / 4], c[0x64 / 4],
+		    c[0x60 / 4], c[0x68 / 4]);
+	}
+	printf("\n");
