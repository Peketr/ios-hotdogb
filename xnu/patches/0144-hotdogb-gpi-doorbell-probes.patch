+/*
+ * 0144: kernels 0139-0143 reset within milliseconds of the first TX doorbell
+ * (CONFIG0 + GO + DMA), wherever the DMA block was. Each probe isolates one
+ * step; run them with boot-args, no rebuild:
+ *   1  TX doorbell with no new TREs (WP = RP): the doorbell write itself
+ *   2  RX DMA TRE alone: the GPI fetches a TRE through the SMMU, no SE command
+ *   3  CONFIG0 alone (IEOT): the GPI programs the SE, no I2C traffic
+ */
+static void
+s3_gpi_probe(int p)
+{
+	uint64_t rxpa = s3.dma_pa + GD_RXBUF;
+	s3_gpi_probe_regs("probe before");
+	switch (p) {
+	case 1:
+		GPIDBG("probe 1: TX doorbell, empty ring");
+		s3_wr(s3.gpi_regs, G_CH_DB(GPI_CH_TX), (uint32_t)(s3.dma_pa + GD_TX_RING + s3.tx_wp));
+		break;
+	case 2:
+		GPIDBG("probe 2: RX DMA TRE alone, ringing RX doorbell");
+		s3_gpi_push(GD_RX_RING, &s3.rx_wp, (uint32_t)rxpa, (uint32_t)(rxpa >> 32), 16,
+		    TRE_TYPE_DMA | TRE_IEOT);
+		s3_dma_sync(GD_RX_RING, GD_RING_LEN);
+		s3_wr(s3.gpi_regs, G_CH_DB(GPI_CH_RX), (uint32_t)(s3.dma_pa + GD_RX_RING + s3.rx_wp));
+		break;
+	case 3:
+		GPIDBG("probe 3: CONFIG0 alone, ringing TX doorbell");
+		s3_gpi_push(GD_TX_RING, &s3.tx_wp, 0x0318050cu, 0, 2, TRE_TYPE_CFG0 | TRE_IEOT);
+		s3_dma_sync(GD_TX_RING, GD_RING_LEN);
+		s3_wr(s3.gpi_regs, G_CH_DB(GPI_CH_TX), (uint32_t)(s3.dma_pa + GD_TX_RING + s3.tx_wp));
+		break;
+	default:
+		printf("SWEET S3706: GPIDBG hdgpiprobe=%d unknown (1-3)\n", p);
+		return;
+	}
+	printf("SWEET S3706: GPIDBG probe %d rung\n", p);
+	sweet_log_kick();
+	for (unsigned i = 0; i < 4; i++) {
+		s3_gpi_probe_regs("probe after");
+		s3_gpi_dump("probe after");
+	}
+	if (p == 2) {
+		(void)s3_gpi_wait(GPI_CH_RX, true);
+	} else if (p == 3) {
+		(void)s3_gpi_wait(GPI_CH_TX, true);
+	}
+	s3_gpi_probe_regs("probe end");
+}
