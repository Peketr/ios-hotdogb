+/* Black everywhere outside the rectangle (x, y, w, h) of a W x H panel with rb-byte rows. */
+static void
+sweet_fb_clear_outside(uintptr_t pix, uint32_t rb, uint32_t W, uint32_t H, uint32_t x, uint32_t y, uint32_t w,
+    uint32_t h)
+{
+	if (w == 0 || h == 0 || x > W || y > H || w > W - x || h > H - y) {
+		return;
+	}
+	if (y) {
+		bzero((void *)pix, (size_t)y * rb);
+	}
+	if (y + h < H) {
+		bzero((void *)(pix + (uint64_t)(y + h) * rb), (size_t)(H - y - h) * rb);
+	}
+	if (x || x + w < W) {
+		for (uint32_t row = y; row < y + h; row++) {
+			uint32_t *line = (uint32_t *)(pix + (uint64_t)row * rb);
+			if (x) {
+				bzero(line, (size_t)x * 4);
+			}
+			if (x + w < W) {
+				bzero(line + x + w, (size_t)(W - x - w) * 4);
+			}
+		}
+	}
+}
