+/* Make CPU writes to the DMA block visible to the GPI (and its writes to us). */
+static void
+s3_dma_sync(unsigned off, unsigned len)
+{
+	if (s3.dma_nc) {
+		__asm__ volatile("dsb sy" ::: "memory");
+	} else {
+		flush_dcache64((addr64_t)(s3.dma_pa + off), len, TRUE);
+	}
+}
