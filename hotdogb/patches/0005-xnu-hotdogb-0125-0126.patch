++	kern_return_t kr = kernel_thread_start(s3_thread, NULL, &thread);
++	if (kr == KERN_SUCCESS) {
++		thread_deallocate(thread);
++	} else {
++		printf("SWEET S3706: kernel_thread_start failed %d\n", kr);
++	}
++}
